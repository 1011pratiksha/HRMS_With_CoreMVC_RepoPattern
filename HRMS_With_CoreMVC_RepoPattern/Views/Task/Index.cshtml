@model List<Tasks>

<div class="row">
    <div class="col">
        <h2>Tasks</h2>

        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a><i class="bi bi-house"></i></a>
            </li>

            <li class="breadcrumb-item">
                Employee
            </li>

            <li class="breadcrumb-item active">
                Tasks
            </li>
        </ol>
    </div>

    <div class="col-auto">
        <a asp-controller="Task"
           asp-action="AddTask"
           class="btn btn-warning">

            <i class="bi bi-plus-circle"></i>
            Add Task

        </a>
    </div>
</div>


<!-- Priority -->

<div class="mt-3">

    <b>Priority</b>

    <a asp-action="Index"
       class="btn btn-outline-secondary ms-2">
        All
    </a>

    <a asp-action="Index"
       asp-route-priority="High"
       class="btn btn-outline-secondary">
        High
    </a>

    <a asp-action="Index"
       asp-route-priority="Medium"
       class="btn btn-outline-secondary">
        Medium
    </a>

    <a asp-action="Index"
       asp-route-priority="Low"
       class="btn btn-outline-secondary">
        Low
    </a>

</div>


<!-- Projects -->

<div class="row mt-4">

    @foreach (var projectGroup in Model.GroupBy(x => x.Project))
    {
        var project = projectGroup.Key;

        var totalTasks = projectGroup.Count();

        var completedTasks =
            projectGroup.Count(x => x.Status == "Completed");

        var percentage =
            totalTasks == 0 ? 0 : completedTasks * 100 / totalTasks;

        <div class="col-md-6">

            <div class="card mb-4">

                <div class="card-header">

                    <h5>
                        @project.ProjectName
                    </h5>

                </div>

                <div class="card-body">

                    <!-- Project Details -->

                    <div class="d-flex justify-content-between">

                        <span>
                            Total Tasks
                        </span>

                        <strong>
                            @totalTasks
                        </strong>

                    </div>

                    <div class="d-flex justify-content-between">

                        <span>
                            Completed
                        </span>

                        <strong>
                            @completedTasks
                        </strong>

                    </div>

                    <div class="d-flex justify-content-between">

                        <span>
                            Project Value
                        </span>

                        <strong>
                            @project.ProjectValue
                        </strong>

                    </div>


                    <!-- Progress -->

                    <div class="mt-3">

                        <div class="d-flex justify-content-between">

                            <span>
                                Progress
                            </span>

                            <span>
                                @percentage%
                            </span>

                        </div>

                        <div class="progress mt-2">

                            <div class="progress-bar"
                                 style="width:@percentage%">
                            </div>

                        </div>

                    </div>


                    <hr />


                    <!-- Tasks -->

                    @foreach (var task in projectGroup)
                    {
                        <div class="card mb-2">

                            <div class="card-body">

                                <h6>
                                    @task.Title
                                </h6>

                                <span class="badge bg-light text-dark">
                                    @task.Priority
                                </span>

                                <span class="badge bg-info">
                                    @task.Status
                                </span>

                                <p class="mt-2 mb-0">

                                    Due on:
                                    @task.Deadline.ToString("dd MMM yyyy")

                                </p>

                            </div>

                        </div>
                    }

                </div>

            </div>

        </div>
    }

</div>