@model List<Tasks>

<div class="row">
    <div class="col">
        <h2>Tasks</h2>

        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a><i class="bi bi-house"></i></a>
            </li>
            <li class="breadcrumb-item">Employee</li>
            <li class="breadcrumb-item active">Tasks</li>
        </ol>
    </div>

    <div class="col-auto">
        <a asp-controller="Task"
           asp-action="AddTask"
           class="btn btn-warning">
            <i class="bi bi-plus-circle"></i>
            Add Task
        </a>
    </div>
</div>


@* Filter *@

<div class="mt-3">

    <b>Priority</b>
    <br />

    <div class="btn-group ms-2">

    <a asp-action="Index"
       class="btn btn-outline-secondary ms-2">
        All
    </a>

    <a asp-action="Index"
       asp-route-priority="High"
       class="btn btn-outline-secondary">
        High
    </a>

    <a asp-action="Index"
       asp-route-priority="Medium"
       class="btn btn-outline-secondary">
        Medium
    </a>

    <a asp-action="Index"
       asp-route-priority="Low"
       class="btn btn-outline-secondary">
        Low
    </a>
</div>
</div>


@* Main *@

<div class="row mt-4">

@* Left Side *@

<div class="col-xl-4">

              @foreach (var projectGroup in Model.GroupBy(task => task.Project))
                {
                    var project = projectGroup.Key;

                    var totalTasks = projectGroup.Count();
                    var completedTasks = projectGroup.Count(task => task.Status == "Completed");

                    var percentage = totalTasks == 0 ? 0 : completedTasks * 100 / totalTasks;
                

        <div class="card mb-3">

            <div class="card-body">


                <div class="d-flex align-items-center">

                  @if (project.LogoPath != null)
                    {
                        <img src="@project.LogoPath" width="50" height="50" />
                    }

                    <div>
                        <h5>
                            @project.ProjectName
                        </h5>

                        <div class="text-muted">
                            @totalTasks tasks
                            •
                            @completedTasks Completed
                        </div>
                    </div>

                </div>

                <hr />


                <div class="row">

                    <div class="col-8">

                        <span>Deadline</span>
                        <br />

                        <span>

                            Due on: 
                           @projectGroup.Max(task => task.Deadline).ToString("dd MMM yyyy")
                            <br />
                            Fixes &
                        </span>

                    </div>

                    <div class="col-4">

                        <span>Value</span>
                        <br />
                        <span>
                            @project.ProjectValue
                        </span>

                    </div>

                </div>


                @* Progress *@

                <div class="bg-light">

                    <span>
                        Total @totalTasks Tasks
                    </span>

                    <span class="float-end">
                        @percentage% Completed
                    </span>

                    <div class="progress mt-2" style="width:80%; height:5px;">

                        <div class="progress-bar"
                             style="width:@percentage%">
                        </div>

                    </div>

                </div>

            </div>

        </div>
    }

</div>


    @* Right side *@

    <div class="col-xl-8">

        @foreach (var projectGroup in Model.GroupBy(task => task.Project))
                {
                    var project = projectGroup.Key;

                    var totalTasks = projectGroup.Count();
                    var completedTasks = projectGroup.Count(task => task.Status == "Completed");

                    var percentage = totalTasks == 0 ? 0 : completedTasks * 100 / totalTasks;
                

            <div class="card mb-3">

                <div class="card-body">

                    <h5 class="mb-3">
                        @project.ProjectName
                    </h5>

                    <div class="bg-light p-3">

                        <span>
                            Tasks Done
                        </span>

                        <h4>
                            @completedTasks / @totalTasks
                        </h4>

                        <div class="progress" style="height:5px;">

                            <div class="progress-bar"
                                 style="width:@percentage%">
                            </div>

                        </div>

                        <p>
                            @percentage%
                        </p>

                    </div>

                </div>

            </div>


@* Task Row *@


            <div class="card mb-3">

                <div class="card-body">

                    <span class="me-2">*</span>

                    <strong>
                        @project.ProjectName
                    </strong>

                    <span class="badge bg-light text-dark ms-2">
                       @projectGroup.Max(task => task.Deadline).ToString("dd MMM yyyy")
                    </span>

                    <span class="badge bg-info float-end">
                        @totalTasks Tasks
                    </span>

                </div>

            </div>
        }

    </div>

</div>