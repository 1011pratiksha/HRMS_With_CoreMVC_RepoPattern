@model List<HRMS_With_CoreMVC_RepoPattern.Models.Termination>

@{
    ViewData["Title"] = "Termination List";
}

@if (TempData["msg"] != null)
{
    <script>
        alert('@TempData["msg"]');
    </script>
}

<h2>Termination List</h2>

<a asp-controller="Termination"asp-action="AddTermination">
    Add Termination
</a>

<br />
<br />

<table border="1">

    <tr>
        <th>Termination ID</th>
        <th>Employee</th>
        <th>Termination Type</th>
        <th>Notice Date</th>
        <th>Resign Date</th>
        <th>Reason</th>
        <th>Action</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>

            <td>
                @item.TerminationId
            </td>

            <td>
                @if (item.User != null)
                {
                    @item.User.FirstName @item.User.LastName
                }
            </td>

            <td>
                @item.TerminationType
            </td>

            <td>
                @item.NoticeDate.ToString("dd/MM/yyyy")
            </td>

            <td>
                @item.ResignDate.ToString("dd/MM/yyyy")
            </td>

            <td>
                @item.Reason
            </td>

            <td>

                <a asp-controller="Termination" asp-action="EditTermination" asp-route-id="@item.TerminationId">Edit</a>

                <form asp-controller="Termination" asp-action="DeleteTermination" method="post">

                    <input type="hidden" name="id" value="@item.TerminationId" />

                    <button type="submit" onclick="return confirm('Are you sure you want to delete this termination?');">Delete</button>

                </form>

            </td>

        </tr>
    }

</table>