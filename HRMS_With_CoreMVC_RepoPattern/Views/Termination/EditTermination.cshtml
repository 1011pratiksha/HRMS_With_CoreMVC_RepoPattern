@model HRMS_With_CoreMVC_RepoPattern.Models.Termination

<h2>Edit Termination</h2>

<form asp-controller="Termination"
      asp-action="EditTermination"
      method="post">

    <input type="hidden" asp-for="TerminationId" />

    <label>User ID</label>
    <input asp-for="UserId" />

    <br /><br />

    <label>Termination Type</label>

    <select asp-for="TerminationType">
        <option value="Retirement">Retirement</option>
        <option value="Lack of Skills">Lack of Skills</option>
        <option value="Insubordination">Insubordination</option>
    </select>

    <br /><br />

    <label>Notice Date</label>
    <input asp-for="NoticeDate" type="date" />

    <br /><br />

    <label>Resign Date</label>
    <input asp-for="ResignDate" type="date" />

    <br /><br />

    <label>Reason</label>
    <textarea asp-for="Reason"></textarea>

    <br /><br />

    <button type="submit">Update</button>

</form>