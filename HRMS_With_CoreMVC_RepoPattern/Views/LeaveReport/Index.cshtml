@model IEnumerable<HRMS_With_CoreMVC_RepoPattern.Models.LeaveReport>

@{
    ViewData["Title"] = "Leave Report";
}

<div class="page-wrapper">

    <!-- Page Header -->
    <div class="d-md-flex d-block align-items-center justify-content-between page-breadcrumb mb-3">
        <div class="my-auto mb-2">
            <h2 class="mb-1">Leave Report</h2>

            <nav>
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item">
                        <a asp-controller="Dashboard" asp-action="Index">
                            Home
                        </a>
                    </li>

                    <li class="breadcrumb-item active">
                        Leave Report
                    </li>
                </ol>
            </nav>
        </div>
    </div>


    <!-- Summary Cards -->
    <div class="row">

        <!-- Total Leaves -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">

                        <div>
                            <h6 class="mb-2">Total Leaves</h6>

                            <h3 class="mb-0">
                                @ViewBag.TotalLeaves
                            </h3>
                        </div>

                        <div class="avatar avatar-lg bg-primary rounded">
                            <i class="ti ti-calendar fs-24"></i>
                        </div>

                    </div>
                </div>
            </div>
        </div>


        <!-- Approved -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">

                        <div>
                            <h6 class="mb-2">Approved</h6>

                            <h3 class="mb-0">
                                @ViewBag.ApprovedLeaves
                            </h3>
                        </div>

                        <div class="avatar avatar-lg bg-success rounded">
                            <i class="ti ti-check fs-24"></i>
                        </div>

                    </div>
                </div>
            </div>
        </div>


        <!-- Pending -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">

                        <div>
                            <h6 class="mb-2">Pending Requests</h6>

                            <h3 class="mb-0">
                                @ViewBag.PendingLeaves
                            </h3>
                        </div>

                        <div class="avatar avatar-lg bg-warning rounded">
                            <i class="ti ti-clock fs-24"></i>
                        </div>

                    </div>
                </div>
            </div>
        </div>


        <!-- Rejected -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">

                        <div>
                            <h6 class="mb-2">Rejected</h6>

                            <h3 class="mb-0">
                                @ViewBag.RejectedLeaves
                            </h3>
                        </div>

                        <div class="avatar avatar-lg bg-danger rounded">
                            <i class="ti ti-x fs-24"></i>
                        </div>

                    </div>
                </div>
            </div>
        </div>

    </div>


    <!-- Leave Report Table -->
    <div class="card">

        <div class="card-header">
            <h5 class="card-title mb-0">
                Leave Details
            </h5>
        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table id="leaveReportTable"
                       class="table table-striped table-hover">

                    <thead>
                        <tr>

                            <th>#</th>

                            <th>Employee</th>

                            <th>Leave Type</th>

                            <th>Start Date</th>

                            <th>End Date</th>

                            <th>Days</th>

                            <th>Reason</th>

                            <th>Approved By</th>

                            <th>Status</th>

                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            int count = 1;

                            foreach (var leave in Model)
                            {
                                <tr>

                                    <td>
                                        @count
                                    </td>

                                    <!-- Employee -->
                                    <td>
                                        <div class="d-flex align-items-center">

                                            @if (!string.IsNullOrEmpty(leave.ProfilePicture))
                                            {
                                                <img src="@leave.ProfilePicture"
                                                     class="avatar avatar-sm rounded-circle me-2"
                                                     alt="Profile">
                                            }
                                            else
                                            {
                                                <div class="avatar avatar-sm rounded-circle bg-secondary text-white me-2">
                                                    @(leave.UserName?.Substring(0, 1).ToUpper())
                                                </div>
                                            }

                                            <span>
                                                @leave.UserName
                                            </span>

                                        </div>
                                    </td>


                                    <!-- Leave Type -->
                                    <td>
                                        @leave.LeaveType
                                    </td>


                                    <!-- Start Date -->
                                    <td>
                                        @leave.StartDate.ToString("dd-MM-yyyy")
                                    </td>


                                    <!-- End Date -->
                                    <td>
                                        @leave.EndDate.ToString("dd-MM-yyyy")
                                    </td>


                                    <!-- Number of Days -->
                                    <td>
                                        @leave.NumberOfDays
                                    </td>


                                    <!-- Reason -->
                                    <td>
                                        @leave.Reason
                                    </td>


                                    <!-- Approved By -->
                                    <td>
                                        @(string.IsNullOrEmpty(leave.ApprovedBy)
                                            ? "-"
                                            : leave.ApprovedBy)
                                    </td>


                                    <!-- Status -->
                                    <td>

                                        @if (leave.Status == "Approved")
                                        {
                                            <span class="badge bg-success">
                                                Approved
                                            </span>
                                        }
                                        else if (leave.Status == "Pending")
                                        {
                                            <span class="badge bg-warning">
                                                Pending
                                            </span>
                                        }
                                        else if (leave.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger">
                                                Rejected
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @leave.Status
                                            </span>
                                        }

                                    </td>

                                </tr>

                                count++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center">
                                    No leave records found.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


@section Scripts
{
    <!-- DataTables -->
    <script>
        $(document).ready(function() {

            $('#leaveReportTable').DataTable({
                pageLength: 10,
                lengthMenu: [10, 25, 50, 100],
                ordering: true,
                searching: true
            });

        });
    </script>
}