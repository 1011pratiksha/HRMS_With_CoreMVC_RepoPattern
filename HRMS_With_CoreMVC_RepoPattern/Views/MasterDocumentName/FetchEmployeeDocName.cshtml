    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@model List<HRMS_With_CoreMVC_RepoPattern.Models.AddEmployeeDocName>

@{
    ViewData["Title"] = "Employee Document Name List";
}

<div class="d-md-flex d-block align-items-center justify-content-between page-breadcrumb mb-3">
    <div class="my-auto mb-2">
        <h2 class="mb-1">Employee Document Name List</h2>
        <nav>
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="#">Home</a></li>
                <li class="breadcrumb-item">Admin</li>
                <li class="breadcrumb-item active" aria-current="page">Employee Document Name List</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex my-xl-auto right-content align-items-center flex-wrap">
        <div class="mb-2">
            <a asp-action="AddDocNameEmployee" class="btn btn-warning d-flex align-items-center">
                <i class="bi bi-plus-circle me-2"></i>Add Document
            </a>
        </div>
    </div>
</div>

@if (TempData["Message"] != null)
{
    <script>
        window.onload = function () {
            alert("@TempData["Message"]");
        };
    </script>
}

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">Employee Document Name List</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="employeeDocTable" class="table datatable">
                <thead class="thead-light">
                    <tr>
                        <th>Document ID</th>
                        <th>Document Name</th>
                        <th class="no-sort">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.DocName</td>
                            <td>
                                <a href="javascript:void(0);" class="me-2"
                                   data-bs-toggle="modal"
                                   data-bs-target="#editModal"
                                   onclick="loadEditModal(@item.Id, '@item.DocName')"
                                   title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="DeleteEmployeeDocName" method="post" style="display:inline;" onsubmit="return confirm('Delete this document name?');">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-link p-0 border-0" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Edit Document Name</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="EditEmployeeDocName" method="post">
                <div class="modal-body">
                    <input type="hidden" name="Id" id="editDocId" />
                    <div class="mb-3">
                        <label class="form-label">Document Name</label>
                        <input type="text" name="DocName" id="editDocName" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-white border me-2" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            if ($.fn.DataTable.isDataTable('#employeeDocTable')) {
                $('#employeeDocTable').DataTable().destroy();
            }
            $('#employeeDocTable').DataTable({
                "info": false,
                "searching": true,
                "ordering": true,
                "order": [],
                "paging": true,
                "pageLength": 5,
                "lengthChange": true,
                "dom": '<"d-flex justify-content-end mb-2"f>rt<"d-flex justify-content-end mt-2"p>',
                "initComplete": function () {
                    $('#employeeDocTable_filter label').addClass('d-flex align-items-center gap-2 mb-0');
                    $('#employeeDocTable_filter input').addClass('form-control form-control-sm');
                },
                "drawCallback": function () {
                    $('#employeeDocTable_paginate .paginate_button').addClass('page-link');
                    $('#employeeDocTable_paginate .paginate_button').wrap('<li class="page-item"></li>');
                    $('#employeeDocTable_paginate').addClass('pagination');
                }
            });
        });

        function loadEditModal(id, docName) {
            $('#editDocId').val(id);
            $('#editDocName').val(docName);
        }
    </script>
}