@model HRMS_With_CoreMVC_RepoPattern.Models.Resignation

<h2>Add Resignation</h2>

<form asp-controller="Resignation"
      asp-action="AddResignation"
      method="post">

    <div asp-validation-summary="All"></div>

    <label>Resigning Employee</label>

    <select asp-for="UserId">
        <option value="">Select Employee</option>

        @foreach (var user in ViewBag.Users)
        {
            <option value="@user.UserId">
                @user.FirstName @user.LastName
            </option>
        }
    </select>

    <br /><br />

    <label>Notice Date</label>
    <input asp-for="NoticeDate" type="date" />

    <br /><br />

    <label>Resignation Date</label>
    <input asp-for="ResignDate" type="date" />

    <br /><br />

    <label>Reason</label>
    <textarea asp-for="Reason"></textarea>

    <br /><br />

    <button type="submit">Add</button>

</form>