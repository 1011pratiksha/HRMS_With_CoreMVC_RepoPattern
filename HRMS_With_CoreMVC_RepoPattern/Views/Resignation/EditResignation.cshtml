@model HRMS_With_CoreMVC_RepoPattern.Models.Resignation

<h2>Edit Resignation</h2>

<form asp-action="EditResignation" method="post">

    <input type="hidden" asp-for="ResignationId" />

    <label>User ID</label>
    <input asp-for="UserId" />

    <br /><br />

    <label>Department ID</label>
    <input asp-for="DepartmentId" />

    <br /><br />

    <label>Notice Date</label>
    <input asp-for="NoticeDate" type="date" />

    <br /><br />

    <label>Resignation Date</label>
    <input asp-for="ResignDate" type="date" />

    <br /><br />

    <label>Reason</label>
    <textarea asp-for="Reason"></textarea>

    <br /><br />

    <button type="submit">Update</button>

</form>