    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@model List<HRMS_With_CoreMVC_RepoPattern.Models.FileUpload>

@{
    ViewData["Title"] = "My Documents";
}

<div class="d-md-flex d-block align-items-center justify-content-between page-breadcrumb mb-3">
    <div class="my-auto mb-2">
        <h2 class="mb-1">My Documents</h2>
        <nav>
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="#">Home</a></li>
                <li class="breadcrumb-item">Documents</li>
                <li class="breadcrumb-item active" aria-current="page">My Documents</li>
            </ol>
        </nav>
    </div>
</div>

@if (TempData["Message"] != null)
{
    <script>
        window.onload = function () {
            alert("@TempData["Message"]");
        };
    </script>
}

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">My Documents</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="docTable" class="table datatable">
                <thead class="thead-light">
                    <tr>
                        <th>Document ID</th>
                        <th>Document Name</th>
                        <th class="no-sort">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.id</td>
                            <td>@item.FileName</td>
                            <td>
                                <a href="@item.FilePath" target="_blank" class="me-2" title="View">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a href="@item.FilePath" download class="me-2" title="Download">
                                    <i class="bi bi-download"></i>
                                </a>
                                <form asp-action="Delete" method="post" style="display:inline;" onsubmit="return confirm('Delete this document?');">
                                    <input type="hidden" name="id" value="@item.id" />
                                    <button type="submit" class="btn btn-link p-0 border-0" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            if ($.fn.DataTable.isDataTable('#docTable')) {
                $('#docTable').DataTable().destroy();
            }
            $('#docTable').DataTable({
                "info": false, "searching": true, "ordering": true, "order": [],
                "paging": true, "pageLength": 5, "lengthChange": true
            });
        });
    </script>
}