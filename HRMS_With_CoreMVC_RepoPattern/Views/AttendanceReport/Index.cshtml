@model IEnumerable<HRMS_With_CoreMVC_RepoPattern.Models.AttendanceReport>

@{
    ViewData["Title"] = "Attendance Report";
}

<link rel="stylesheet" href="~/css/attendance-report.css" />

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Attendance Report</h2>
            <p class="text-muted">Employee attendance details</p>
        </div>
    </div>

    <!-- Summary -->
    <div class="row mb-4">

        <div class="col-md-4">
            <div class="report-card">
                <h6>Total Attendance</h6>
                <h3>@ViewBag.TotalAttendance</h3>
            </div>
        </div>

        <div class="col-md-4">
            <div class="report-card">
                <h6>Present</h6>
                <h3>@ViewBag.PresentAttendance</h3>
            </div>
        </div>

        <div class="col-md-4">
            <div class="report-card">
                <h6>Absent</h6>
                <h3>@ViewBag.AbsentAttendance</h3>
            </div>
        </div>

    </div>


    <!-- Attendance Table -->
    <div class="card">

        <div class="card-header">
            <h5>Attendance List</h5>
        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-bordered table-hover">

                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Employee</th>
                            <th>Date</th>
                            <th>Check In</th>
                            <th>Check Out</th>
                            <th>Lunch In</th>
                            <th>Lunch Out</th>
                            <th>Status</th>
                            <th>Working Hours</th>
                            <th>Overtime</th>
                            <th>Break Hours</th>
                            <th>Late</th>
                            <th>Production Hours</th>
                        </tr>
                    </thead>

                    <tbody>

                        @{
                            int i = 1;
                        }

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>@i</td>

                                <td>
                                    @item.UserName
                                </td>

                                <td>
                                    @item.Date.ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    @item.CheckIn?.ToString("hh:mm tt")
                                </td>

                                <td>
                                    @item.CheckOut?.ToString("hh:mm tt")
                                </td>

                                <td>
                                    @item.LunchIn?.ToString("hh:mm tt")
                                </td>

                                <td>
                                    @item.LunchOut?.ToString("hh:mm tt")
                                </td>

                                <td>
                                    @item.Status
                                </td>

                                <td>
                                    @item.WorkingHours
                                </td>

                                <td>
                                    @item.OvertimeHours
                                </td>

                                <td>
                                    @item.BreakHours
                                </td>

                                <td>
                                    @item.Late
                                </td>

                                <td>
                                    @item.ProductionHours
                                </td>

                            </tr>

                            i++;
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>