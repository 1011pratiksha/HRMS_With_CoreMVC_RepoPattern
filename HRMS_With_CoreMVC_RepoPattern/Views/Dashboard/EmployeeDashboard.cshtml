
@model HRMS_With_CoreMVC_RepoPattern.Models.User

@{
    ViewData["Title"] = "Employee Dashboard";

    var attendance =
        ViewBag.TodayAttendance as HRMS_With_CoreMVC_RepoPattern.Models.Attendance;

    var leaveRequests =
        ViewBag.LeaveRequests as List<HRMS_With_CoreMVC_RepoPattern.Models.LeaveRequest>
        ?? new List<HRMS_With_CoreMVC_RepoPattern.Models.LeaveRequest>();

    var projects =
        ViewBag.EmployeeProjects as List<HRMS_With_CoreMVC_RepoPattern.Models.Projects>
        ?? new List<HRMS_With_CoreMVC_RepoPattern.Models.Projects>();

    var tasks =
        ViewBag.EmployeeTasks as List<HRMS_With_CoreMVC_RepoPattern.Models.Tasks>
        ?? new List<HRMS_With_CoreMVC_RepoPattern.Models.Tasks>();

    var totalLeaves = ViewBag.TotalLeaves ?? 0;
    var pendingLeaves = ViewBag.PendingLeaves ?? 0;
    var approvedLeaves = ViewBag.ApprovedLeaves ?? 0;
    var rejectedLeaves = ViewBag.RejectedLeaves ?? 0;

    var totalTasks = ViewBag.TotalTasks ?? 0;
    var completedTasks = ViewBag.CompletedTasks ?? 0;
    var pendingTasks = ViewBag.PendingTasks ?? 0;
    var inProgressTasks = ViewBag.InProgressTasks ?? 0;

    var taskPerformance = ViewBag.TaskPerformance ?? 0;
    var attendancePerformance = ViewBag.AttendancePerformance ?? 0;
    var overallPerformance = ViewBag.OverallPerformance ?? 0;

    var productionHours = ViewBag.ProductionHours ?? 0;
    var workingHours = ViewBag.WorkingHours ?? 0;
    var breakHours = ViewBag.BreakHours ?? 0;

    var employeeInitials =
        !string.IsNullOrWhiteSpace(Model.FirstName)
            ? Model.FirstName.Substring(0, 1).ToUpper()
            : "";

    if (!string.IsNullOrWhiteSpace(Model.LastName))
    {
        employeeInitials +=
            Model.LastName.Substring(0, 1).ToUpper();
    }

    var employeeProfileImage = "";

    if (!string.IsNullOrWhiteSpace(Model.ProfilePicture))
    {
        employeeProfileImage = Model.ProfilePicture
            .Replace("\\", "/")
            .Replace("wwwroot/", "/");

        if (!employeeProfileImage.StartsWith("/"))
        {
            employeeProfileImage =
                "/" + employeeProfileImage;
        }
    }
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>


<div class="container-fluid py-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Employee Dashboard
            </h2>

            <p class="text-muted mb-0">
                Welcome back, @Model.FirstName @Model.LastName
            </p>
        </div>

        <div class="text-end">
            <span class="badge bg-primary fs-6">
                Employee
            </span>

            <div class="text-muted mt-1">
                @DateTime.Now.ToString("dd MMM yyyy")
            </div>
        </div>

    </div>


    <!-- PROFILE -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <div class="row align-items-center">

                <div class="col-md-4">

                    <div class="d-flex align-items-center">

                        @if (!string.IsNullOrWhiteSpace(employeeProfileImage))
                        {
                            <img src="@employeeProfileImage"
                                 alt="Employee Profile"
                                 class="rounded-circle me-3"
                                 style="width:75px;height:75px;object-fit:cover;">
                        }
                        else
                        {
                            <div class="bg-primary text-white rounded-circle
                                        d-flex align-items-center justify-content-center
                                        me-3"
                                 style="width:75px;height:75px;">

                                <strong class="fs-4">
                                    @employeeInitials
                                </strong>

                            </div>
                        }

                        <div>

                            <h4 class="fw-bold mb-1">
                                @Model.FirstName @Model.LastName
                            </h4>

                            <p class="text-muted mb-1">
                                @(Model.Designation?.Name ?? "--")
                            </p>

                            <span class="badge bg-success">
                                @(Model.Status ?? "Active")
                            </span>

                        </div>

                    </div>

                </div>


                <div class="col-md-8">

                    <div class="row">

                        <div class="col-md-6 mb-2">
                            <strong>
                                <i class="bi bi-envelope me-2"></i>
                                Email:
                            </strong>
                            @Model.Email
                        </div>

                        <div class="col-md-6 mb-2">
                            <strong>
                                <i class="bi bi-telephone me-2"></i>
                                Phone:
                            </strong>
                            @(Model.PhoneNumber ?? "--")
                        </div>

                        <div class="col-md-6 mb-2">
                            <strong>
                                <i class="bi bi-building me-2"></i>
                                Department:
                            </strong>
                            @(Model.Department?.Name ?? "--")
                        </div>

                        <div class="col-md-6 mb-2">
                            <strong>
                                <i class="bi bi-calendar me-2"></i>
                                Joining Date:
                            </strong>
                            @(Model.DateOfJoining?.ToString("dd-MM-yyyy") ?? "--")
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- TODAY ATTENDANCE -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white">

            <h5 class="fw-bold mb-0">
                <i class="bi bi-clock me-2"></i>
                Today's Attendance
            </h5>

        </div>

        <div class="card-body">

            <div class="row g-3">

                <!-- CHECK IN -->
                <div class="col-md-3">

                    <div class="border rounded p-3 text-center">

                        <i class="bi bi-box-arrow-in-right fs-2 text-success"></i>

                        <h6 class="mt-2">
                            Check In
                        </h6>

                        <p class="fw-bold mb-3">
                            @(attendance?.CheckIn?.ToString("hh:mm tt") ?? "--")
                        </p>

                        @if (attendance?.CheckIn == null)
                        {
                            <form asp-controller="Attendance"
                                  asp-action="CheckIn"
                                  method="post">

                                <button type="submit"
                                        class="btn btn-success w-100">
                                    Check In
                                </button>

                            </form>
                        }
                        else
                        {
                            <button class="btn btn-success w-100"
                                    disabled>
                                Checked In
                            </button>
                        }

                    </div>

                </div>


                <!-- LUNCH IN -->
                <div class="col-md-3">

                    <div class="border rounded p-3 text-center">

                        <i class="bi bi-cup-hot fs-2 text-warning"></i>

                        <h6 class="mt-2">
                            Lunch In
                        </h6>

                        <p class="fw-bold mb-3">
                            @(attendance?.LunchIn?.ToString("hh:mm tt") ?? "--")
                        </p>

                        @if (attendance?.CheckIn != null &&
                             attendance?.LunchIn == null)
                        {
                            <form asp-controller="Attendance"
                                  asp-action="LunchIn"
                                  method="post">

                                <button type="submit"
                                        class="btn btn-warning w-100">
                                    Lunch In
                                </button>

                            </form>
                        }
                        else
                        {
                            <button class="btn btn-warning w-100"
                                    disabled>
                                @(attendance?.LunchIn != null
                                    ? "Lunch Started"
                                    : "Lunch In")
                            </button>
                        }

                    </div>

                </div>


                <!-- LUNCH OUT -->
                <div class="col-md-3">

                    <div class="border rounded p-3 text-center">

                        <i class="bi bi-cup-hot-fill fs-2 text-info"></i>

                        <h6 class="mt-2">
                            Lunch Out
                        </h6>

                        <p class="fw-bold mb-3">
                            @(attendance?.LunchOut?.ToString("hh:mm tt") ?? "--")
                        </p>

                        @if (attendance?.LunchIn != null &&
                             attendance?.LunchOut == null)
                        {
                            <form asp-controller="Attendance"
                                  asp-action="LunchOut"
                                  method="post">

                                <button type="submit"
                                        class="btn btn-info w-100">
                                    Lunch Out
                                </button>

                            </form>
                        }
                        else
                        {
                            <button class="btn btn-info w-100"
                                    disabled>
                                @(attendance?.LunchOut != null
                                    ? "Lunch Ended"
                                    : "Lunch Out")
                            </button>
                        }

                    </div>

                </div>


                <!-- CHECK OUT -->
                <div class="col-md-3">

                    <div class="border rounded p-3 text-center">

                        <i class="bi bi-box-arrow-right fs-2 text-danger"></i>

                        <h6 class="mt-2">
                            Check Out
                        </h6>

                        <p class="fw-bold mb-3">
                            @(attendance?.CheckOut?.ToString("hh:mm tt") ?? "--")
                        </p>

                        @if (attendance?.CheckIn != null &&
                             attendance?.CheckOut == null)
                        {
                            <form asp-controller="Attendance"
                                  asp-action="CheckOut"
                                  method="post">

                                <button type="submit"
                                        class="btn btn-danger w-100">
                                    Check Out
                                </button>

                            </form>
                        }
                        else
                        {
                            <button class="btn btn-danger w-100"
                                    disabled>
                                @(attendance?.CheckOut != null
                                    ? "Checked Out"
                                    : "Check Out")
                            </button>
                        }

                    </div>

                </div>

            </div>


            <!-- HOURS -->

            <div class="row mt-4">

                <div class="col-md-4">
                    <div class="alert alert-primary mb-0">
                        <strong>Working Hours:</strong>
                        @workingHours.ToString("0.00") hrs
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="alert alert-warning mb-0">
                        <strong>Break Hours:</strong>
                        @breakHours.ToString("0.00") hrs
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="alert alert-success mb-0">
                        <strong>Production Hours:</strong>
                        @productionHours.ToString("0.00") hrs
                    </div>
                </div>

            </div>

        </div>

    </div>


    <!-- STAT CARDS -->

    <div class="row g-3 mb-4">

        <div class="col-md-3">

            <div class="card shadow-sm border-0">
                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>
                            <h6 class="text-muted">
                                Projects
                            </h6>

                            <h3 class="fw-bold">
                                @projects.Count
                            </h3>
                        </div>

                        <i class="bi bi-folder2-open fs-1 text-primary"></i>

                    </div>

                </div>
            </div>

        </div>


        <div class="col-md-3">

            <div class="card shadow-sm border-0">
                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>
                            <h6 class="text-muted">
                                Total Tasks
                            </h6>

                            <h3 class="fw-bold">
                                @totalTasks
                            </h3>
                        </div>

                        <i class="bi bi-list-task fs-1 text-info"></i>

                    </div>

                </div>
            </div>

        </div>


        <div class="col-md-3">

            <div class="card shadow-sm border-0">
                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>
                            <h6 class="text-muted">
                                Completed Tasks
                            </h6>

                            <h3 class="fw-bold">
                                @completedTasks
                            </h3>
                        </div>

                        <i class="bi bi-check-circle fs-1 text-success"></i>

                    </div>

                </div>
            </div>

        </div>


        <div class="col-md-3">

            <div class="card shadow-sm border-0">
                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>
                            <h6 class="text-muted">
                                Performance
                            </h6>

                            <h3 class="fw-bold">
                                @overallPerformance%
                            </h3>
                        </div>

                        <i class="bi bi-graph-up-arrow fs-1 text-warning"></i>

                    </div>

                </div>
            </div>

        </div>

    </div>


    <!-- LEAVE DETAILS + PERFORMANCE -->

    <div class="row g-4 mb-4">

        <!-- LEAVE -->

        <div class="col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header bg-white">

                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-calendar-x me-2"></i>
                        Leave Details
                    </h5>

                </div>

                <div class="card-body">

                    <div class="row text-center">

                        <div class="col-3">
                            <h4 class="fw-bold">
                                @totalLeaves
                            </h4>
                            <small class="text-muted">
                                Total
                            </small>
                        </div>

                        <div class="col-3">
                            <h4 class="fw-bold text-warning">
                                @pendingLeaves
                            </h4>
                            <small class="text-muted">
                                Pending
                            </small>
                        </div>

                        <div class="col-3">
                            <h4 class="fw-bold text-success">
                                @approvedLeaves
                            </h4>
                            <small class="text-muted">
                                Approved
                            </small>
                        </div>

                        <div class="col-3">
                            <h4 class="fw-bold text-danger">
                                @rejectedLeaves
                            </h4>
                            <small class="text-muted">
                                Rejected
                            </small>
                        </div>

                    </div>

                    <hr />

                    @if (leaveRequests.Any())
                    {
                        <div class="table-responsive">

                            <table class="table table-sm table-hover">

                                <thead>
                                    <tr>
                                        <th>Type</th>
                                        <th>Start</th>
                                        <th>End</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    @foreach (var leave in leaveRequests.Take(5))
                                    {
                                        <tr>

                                            <td>
                                                @(leave.MasterLeaveType?.LeaveType ?? "--")
                                            </td>

                                            <td>
                                                @leave.StartDate.ToString("dd-MM-yyyy")
                                            </td>

                                            <td>
                                                @leave.EndDate.ToString("dd-MM-yyyy")
                                            </td>

                                            <td>
                                                @if (leave.Status == "Approved")
                                                {
                                                    <span class="badge bg-success">
                                                        Approved
                                                    </span>
                                                }
                                                else if (leave.Status == "Rejected")
                                                {
                                                    <span class="badge bg-danger">
                                                        Rejected
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark">
                                                        @leave.Status
                                                    </span>
                                                }
                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            No leave records found.
                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- PERFORMANCE -->

        <div class="col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header bg-white">

                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-bar-chart me-2"></i>
                        Performance
                    </h5>

                </div>

                <div class="card-body">

                    <div style="height:300px;">
                        <canvas id="employeePerformanceChart"></canvas>
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- PROJECTS -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white">

            <h5 class="fw-bold mb-0">
                <i class="bi bi-folder2-open me-2"></i>
                My Projects
            </h5>

        </div>

        <div class="card-body">

            @if (projects.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Project</th>
                                <th>Client</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>Priority</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var project in projects)
                            {
                                <tr>

                                    <td class="fw-semibold">
                                        @project.ProjectName
                                    </td>

                                    <td>
                                        @project.ClientName
                                    </td>

                                    <td>
                                        @project.StartDate.ToString("dd-MM-yyyy")
                                    </td>

                                    <td>
                                        @project.EndDate.ToString("dd-MM-yyyy")
                                    </td>

                                    <td>
                                        @if (project.Priority == "High")
                                        {
                                            <span class="badge bg-danger">
                                                High
                                            </span>
                                        }
                                        else if (project.Priority == "Medium")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Medium
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @project.Priority
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <span class="badge bg-primary">
                                            @project.Status
                                        </span>
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center text-muted py-4">
                    No projects assigned.
                </div>
            }

        </div>

    </div>


    <!-- TASKS -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="fw-bold mb-0">
                    <i class="bi bi-list-task me-2"></i>
                    My Tasks
                </h5>

                <div>

                    <span class="badge bg-success me-1">
                        Completed: @completedTasks
                    </span>

                    <span class="badge bg-warning text-dark me-1">
                        Pending: @pendingTasks
                    </span>

                    <span class="badge bg-info">
                        In Progress: @inProgressTasks
                    </span>

                </div>

            </div>

        </div>

        <div class="card-body">

            @if (tasks.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>

                            <tr>
                                <th>Task</th>
                                <th>Project</th>
                                <th>Deadline</th>
                                <th>Priority</th>
                                <th>Status</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var task in tasks)
                            {
                                <tr>

                                    <td>
                                        <strong>
                                            @task.Title
                                        </strong>

                                        @if (!string.IsNullOrWhiteSpace(task.Description))
                                        {
                                            <br />
                                            <small class="text-muted">
                                                @task.Description
                                            </small>
                                        }
                                    </td>

                                    <td>
                                        @(task.Project?.ProjectName ?? "--")
                                    </td>

                                    <td>
                                        @task.Deadline.ToString("dd-MM-yyyy")
                                    </td>

                                    <td>

                                        @if (task.Priority == "High")
                                        {
                                            <span class="badge bg-danger">
                                                High
                                            </span>
                                        }
                                        else if (task.Priority == "Medium")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Medium
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @task.Priority
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        @if (task.Status == "Completed")
                                        {
                                            <span class="badge bg-success">
                                                Completed
                                            </span>
                                        }
                                        else if (task.Status == "In Progress")
                                        {
                                            <span class="badge bg-info">
                                                In Progress
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                @task.Status
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center text-muted py-4">
                    No tasks assigned.
                </div>
            }

        </div>

    </div>

</div>


<!-- PERFORMANCE CHART -->

<script>

    const performanceLabels = [
        "Task Performance",
        "Attendance",
        "Overall"
    ];

    const performanceValues = [
        @taskPerformance,
        @attendancePerformance,
        @overallPerformance
    ];

    const ctx =
        document.getElementById('employeePerformanceChart');

    new Chart(ctx, {

        type: 'bar',

        data: {

            labels: performanceLabels,

            datasets: [{

                label: 'Performance %',

                data: performanceValues,

                borderWidth: 1

            }]

        },

        options: {

            responsive: true,

            maintainAspectRatio: false,

            scales: {

                y: {

                    beginAtZero: true,

                    max: 100,

                    ticks: {

                        callback: function(value) {
                            return value + '%';
                        }

                    }

                }

            },

            plugins: {

                legend: {

                    display: false

                }

            }

        }

    });

</script>

