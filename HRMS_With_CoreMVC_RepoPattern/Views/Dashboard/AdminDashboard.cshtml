<style>

.sidebar {
    width: 260px;
    min-height: 100vh;
    background-color: #ffffff;
    border-right: 1px solid #e5e5e5;
    padding: 20px 12px;
    box-sizing: border-box;
    overflow-y: auto;
}

.menu-title {
    font-size: 12px;
    font-weight: 600;
    color: #999;
    padding: 10px 15px;
    margin-bottom: 5px;
}


.menu-item {
    width: 100%;
}

.menu-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    text-decoration: none;
    color: #333;
    font-size: 14px;
    padding: 11px 15px;
    border-radius: 5px;
    cursor: pointer;
}

.menu-link:hover {
    background-color: #f5f5f5;
}



.arrow {
    font-size: 10px;
    transition: transform 0.2s ease;
}


.submenu {
    display: none;
    padding-left: 15px;
}

.submenu a {
    display: block;
    text-decoration: none;
    color: #666;
    font-size: 13px;
    padding: 8px 15px;
}

.submenu a:hover {
    color: #000;
    background-color: #f7f7f7;
}



.nested-submenu {
    display: none;
    padding-left: 15px;
}

.nested-submenu a {
    display: block;
    padding: 7px 15px;
    font-size: 12px;
}

   
.menu-item.open > .submenu {
    display: block;
}

.submenu-item.open > .nested-submenu {
    display: block;
}

.menu-item.open > .menu-link .arrow,
.submenu-item.open > .submenu-link .arrow {
    transform: rotate(180deg);
}



.submenu-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    text-decoration: none;
    color: #666;
    font-size: 13px;
    padding: 8px 15px;
    cursor: pointer;
}

.submenu-link:hover {
    background-color: #f7f7f7;
}
    </style>


<script>

    function Dropdown(element) {

        var parent = element.parentElement;

        parent.classList.toggle("open");

    }

</script>

