
@{
    ViewData["title"] = "Manager Dashboard";
}
<link rel="stylesheet" href="~/css/Dashboard.css" asp-append-version="true" />
<div class="sidebar">

    <div class="menu-title">Main Menu</div>
 
    <div class="menu-item">
        <a href="javascript:void(0)" class="menu-link" onclick="Dropdown(this)">
            <span>Projects</span>
            <span class="arrow">▼</span>
        </a>

        <div class="submenu">
            <a href="">Project</a>
            <a href="">Task</a>
            <a href="">TaskBoard</a>
        </div>
    </div>

    <div class="menu-item">
        <a href="javascript:void(0)" class="menu-link" onclick="Dropdown(this)">
            <span>Leave</span>
            <span class="arrow">▼</span>
        </a>

        <div class="submenu">

            <div class="submenu-item">
                <a href="javascript:void(0)" class="submenu-link" onclick="Dropdown(this)">
                    <span>Leaves</span>
                    <span class="arrow">▼</span>
                </a>

                <div class="nested-submenu">

                    <a href="/Leave/ViewLeaveRequests">
                        Leave Approval
                    </a>

                    <a href="/ManagerTimesheet/Approval">
                        Timesheet Approval
                    </a>

                    <a href="/Leave/DepartmentLeaveDetails">
                        Leave Allocation
                    </a>

                </div>
            </div>

        </div>
    </div>

 
    <div class="menu-item">
        <a href="javascript:void(0)" class="menu-link" onclick="Dropdown(this)">
            <span>Tickets</span>
            <span class="arrow">▼</span>
        </a>

        <div class="submenu">
            <a href="">Tickets</a>
            <a href="">Ticket Details</a>
        </div>
    </div>


    <div class="menu-item">
        <a href="" class="menu-link">
            <span>Logout</span>
        </a>
    </div>

</div>





<script>

    function Dropdown(element) {

        var parent = element.parentElement;

        parent.classList.toggle("open");

    }

</script>

