@{
    ViewData["Title"] = "Manager Dashboard";
}

<div class="container-fluid">

    <div class="d-flex align-items-center justify-content-between mb-3">

        <div>

            <h2 class="mb-1">
                Manager Dashboard
            </h2>

            <p class="text-muted mb-0">
                Welcome to Manager Dashboard
            </p>

        </div>

    </div>


    <div class="row">

        <div class="col-md-3 mb-3">

            <div class="card">

                <div class="card-body">

                    <h6 class="text-muted">
                        Total Projects
                    </h6>

                    <h3>0</h3>

                </div>

            </div>

        </div>


        <div class="col-md-3 mb-3">

            <div class="card">

                <div class="card-body">

                    <h6 class="text-muted">
                        Total Tasks
                    </h6>

                    <h3>0</h3>

                </div>

            </div>

        </div>


        <div class="col-md-3 mb-3">

            <div class="card">

                <div class="card-body">

                    <h6 class="text-muted">
                        Pending Tasks
                    </h6>

                    <h3>0</h3>

                </div>

            </div>

        </div>


        <div class="col-md-3 mb-3">

            <div class="card">

                <div class="card-body">

                    <h6 class="text-muted">
                        Team Members
                    </h6>

                    <h3>0</h3>

                </div>

            </div>

        </div>

    </div>

</div>