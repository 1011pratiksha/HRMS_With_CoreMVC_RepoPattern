
@{
    ViewData["title"] = "Manager Dashboard";
}

<div class="sidebar">

    <div class="menu-title">Main Menu</div>
 
    <div class="menu-item">
        <a href="javascript:void(0)" class="menu-link" onclick="Dropdown(this)">
            <span>Projects</span>
            <span class="arrow">▼</span>
        </a>

        <div class="submenu">
            <a href="">Project</a>
            <a href="">Task</a>
            <a href="">TaskBoard</a>
        </div>
    </div>

    <div class="menu-item">
        <a href="javascript:void(0)" class="menu-link" onclick="Dropdown(this)">
            <span>Leave</span>
            <span class="arrow">▼</span>
        </a>

        <div class="submenu">
            <a href="">Leaves</a>
        </div>
    </div>


 
    <div class="menu-item">
        <a href="javascript:void(0)" class="menu-link" onclick="Dropdown(this)">
            <span>Tickets</span>
            <span class="arrow">▼</span>
        </a>

        <div class="submenu">
            <a href="">Tickets</a>
            <a href="">Ticket Details</a>
        </div>
    </div>


    <div class="menu-item">
        <a href="" class="menu-link">
            <span>Logout</span>
        </a>
    </div>

</div>


<style>

    .sidebar {
        width: 260px;
        min-height: 100vh;
        background-color: #ffffff;
        border-right: 1px solid #e5e5e5;
        padding: 20px 12px;
        box-sizing: border-box;
        overflow-y: auto;
    }

    .menu-title {
        font-size: 12px;
        font-weight: 600;
        color: #999;
        padding: 10px 15px;
        margin-bottom: 5px;
    }

    .menu-item {
        width: 100%;
    }

    .menu-link {
        display: flex;
        align-items: center;
        justify-content: space-between;
        text-decoration: none;
        color: #333;
        font-size: 14px;
        padding: 11px 15px;
        border-radius: 5px;
        cursor: pointer;
    }

        .menu-link:hover {
            background-color: #f5f5f5;
        }

    .arrow {
        font-size: 10px;
        transition: transform 0.2s ease;
    }

    .submenu {
        display: none;
        padding-left: 15px;
    }

        .submenu a {
            display: block;
            text-decoration: none;
            color: #666;
            font-size: 13px;
            padding: 8px 15px;
        }

            .submenu a:hover {
                color: #000;
                background-color: #f7f7f7;
            }

    .menu-item.open > .submenu {
        display: block;
    }

    .menu-item.open > .menu-link .arrow {
        transform: rotate(180deg);
    }

</style>


<script>

    function Dropdown(element) {

        var parent = element.parentElement;

        parent.classList.toggle("open");

    }

</script>

