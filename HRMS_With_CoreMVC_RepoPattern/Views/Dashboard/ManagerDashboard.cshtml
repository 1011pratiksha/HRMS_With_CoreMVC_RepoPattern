<!-- TODAY'S ATTENDANCE -->

<div class="card shadow-sm border-0 mb-4">

    <div class="card-body">

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-4">

            <div>

                <h5 class="fw-bold mb-1">

                    <i class="bi bi-clock-history me-2"></i>

                    Today's Attendance

                </h5>

                @if (todayAttendance == null)
                {
                    <small class="text-muted">
                        You have not checked in today.
                    </small>
                }
                else if (todayAttendance.CheckOut == null)
                {
                    <small class="text-success">
                        You are currently checked in.
                    </small>
                }
                else
                {
                    <small class="text-primary">
                        Today's attendance is completed.
                    </small>
                }

            </div>


            <div class="text-center">

                <small class="text-muted d-block">
                    Check In
                </small>

                <strong>
                    @(todayAttendance?.CheckIn?.ToString("hh:mm tt") ?? "--")
                </strong>

            </div>


            <div class="text-center">

                <small class="text-muted d-block">
                    Lunch In
                </small>

                <strong>
                    @(todayAttendance?.LunchIn?.ToString("hh:mm tt") ?? "--")
                </strong>

            </div>


            <div class="text-center">

                <small class="text-muted d-block">
                    Lunch Out
                </small>

                <strong>
                    @(todayAttendance?.LunchOut?.ToString("hh:mm tt") ?? "--")
                </strong>

            </div>


            <div class="text-center">

                <small class="text-muted d-block">
                    Check Out
                </small>

                <strong>
                    @(todayAttendance?.CheckOut?.ToString("hh:mm tt") ?? "--")
                </strong>

            </div>


            <div class="text-center">

                <small class="text-muted d-block">
                    Working Hours
                </small>

                <strong>
                    @(todayAttendance != null
                        ? todayAttendance.WorkingHours.ToString("0.00") + " hrs"
                        : "--")
                </strong>

            </div>


            <div>

                @if (todayAttendance == null ||
                     todayAttendance.CheckIn == null)
                {
                    <form asp-controller="Attendance"
                          asp-action="CheckIn"
                          method="post">

                        <button type="submit"
                                class="btn btn-success">

                            <i class="bi bi-box-arrow-in-right me-1"></i>

                            Check In

                        </button>

                    </form>
                }
                else if (todayAttendance.LunchIn == null)
                {
                    <form asp-controller="Attendance"
                          asp-action="LunchIn"
                          method="post">

                        <button type="submit"
                                class="btn btn-warning">

                            <i class="bi bi-cup-hot me-1"></i>

                            Lunch In

                        </button>

                    </form>
                }
                else if (todayAttendance.LunchOut == null)
                {
                    <form asp-controller="Attendance"
                          asp-action="LunchOut"
                          method="post">

                        <button type="submit"
                                class="btn btn-info">

                            <i class="bi bi-cup-hot me-1"></i>

                            Lunch Out

                        </button>

                    </form>
                }
                else if (todayAttendance.CheckOut == null)
                {
                    <form asp-controller="Attendance"
                          asp-action="CheckOut"
                          method="post">

                        <button type="submit"
                                class="btn btn-danger">

                            <i class="bi bi-box-arrow-right me-1"></i>

                            Check Out

                        </button>

                    </form>
                }
                else
                {
                    <span class="badge text-bg-success p-2">

                        <i class="bi bi-check-circle me-1"></i>

                        Attendance Completed

                    </span>
                }

            </div>

        </div>

    </div>

</div>


