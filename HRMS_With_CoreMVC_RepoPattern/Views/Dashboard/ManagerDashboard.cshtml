@model HRMS_With_CoreMVC_RepoPattern.Models.AdminDashboardViewModel

@{
ViewData["Title"] = "Manager Dashboard";

var todayAttendance =
    ViewBag.TodayAttendance as HRMS_With_CoreMVC_RepoPattern.Models.Attendance;

var managerProfile =
    ViewBag.ManagerProfile as HRMS_With_CoreMVC_RepoPattern.Models.User;

var pendingLeaveRequests =
    ViewBag.PendingLeaveRequests as List<HRMS_With_CoreMVC_RepoPattern.Models.LeaveRequest>
    ?? new List<HRMS_With_CoreMVC_RepoPattern.Models.LeaveRequest>();

var teamAttendance =
    Model.TodayAttendance ??
    new List<HRMS_With_CoreMVC_RepoPattern.Models.AttendanceDashboardViewModel>();

var presentCount =
    teamAttendance.Count(x => x.Status == "Present");

var lateCount =
    teamAttendance.Count(x => x.Status == "Late");

var absentCount =
    Model.TeamMembers - teamAttendance.Count;

if (absentCount < 0)
{
    absentCount = 0;
}

var presentPercentage =
    Model.TeamMembers > 0
    ? (presentCount * 100 / Model.TeamMembers)
    : 0;

var latePercentage =
    Model.TeamMembers > 0
    ? (lateCount * 100 / Model.TeamMembers)
    : 0;

var absentPercentage =
    Model.TeamMembers > 0
    ? (absentCount * 100 / Model.TeamMembers)
    : 0;

var leavePercentage =
    Model.TeamMembers > 0
    ? (pendingLeaveRequests.Count * 100 / Model.TeamMembers)
    : 0;

var managerInitials = "M";

// ==============================
// MANAGER PROFILE IMAGE
// ==============================

var managerProfileImage = "";

if (managerProfile != null)
{
    var firstInitial =
        !string.IsNullOrWhiteSpace(managerProfile.FirstName)
            ? managerProfile.FirstName.Substring(0, 1).ToUpper()
            : "";

    var lastInitial =
        !string.IsNullOrWhiteSpace(managerProfile.LastName)
            ? managerProfile.LastName.Substring(0, 1).ToUpper()
            : "";

    managerInitials = firstInitial + lastInitial;

    if (string.IsNullOrWhiteSpace(managerInitials))
    {
        managerInitials = "M";
    }

    // Take ProfilePicture value from database
    if (!string.IsNullOrWhiteSpace(managerProfile.ProfilePicture))
    {
        managerProfileImage = managerProfile.ProfilePicture
            .Replace("\\", "/")
            .Replace("wwwroot/", "/");

        if (!managerProfileImage.StartsWith("/"))
        {
            managerProfileImage = "/" + managerProfileImage;
        }
    }
}


}

