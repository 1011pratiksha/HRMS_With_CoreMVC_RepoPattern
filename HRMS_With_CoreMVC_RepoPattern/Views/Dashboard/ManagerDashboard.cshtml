<!-- TEAM ATTENDANCE TABLE -->

<div class="card shadow-sm border-0 mb-4">

    <div class="card-body">

        <h5 class="fw-bold mb-3">
            Team Attendance
        </h5>


        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>

                        <th>Employee</th>

                        <th>Check In</th>

                        <th>Check Out</th>

                        <th>Status</th>

                        <th>Late</th>

                    </tr>

                </thead>


                <tbody>

                    @if (teamAttendance.Any())
                    {
                        foreach (var employee in teamAttendance)
                        {
                            var initials = "NA";

                            if (!string.IsNullOrWhiteSpace(employee.EmployeeName))
                            {
                                var nameParts =
                                    employee.EmployeeName
                                    .Split(' ', StringSplitOptions.RemoveEmptyEntries);

                                if (nameParts.Length >= 2)
                                {
                                    initials =
                                        nameParts[0].Substring(0, 1).ToUpper() +
                                        nameParts[1].Substring(0, 1).ToUpper();
                                }
                                else if (nameParts.Length == 1)
                                {
                                    initials =
                                        nameParts[0].Substring(0, 1).ToUpper();
                                }
                            }

                            var statusClass = employee.Status switch
                            {
                                "Present" => "text-bg-success",
                                "Late" => "text-bg-warning",
                                "Absent" => "text-bg-danger",
                                "On Leave" => "text-bg-info",
                                _ => "text-bg-secondary"
                            };

                            <tr>

                                <td>

                                    <span class="badge rounded-circle text-bg-primary p-2 me-2">

                                        @initials

                                    </span>

                                    @employee.EmployeeName

                                </td>


                                <td>

                                    @(employee.CheckIn?.ToString("hh:mm tt") ?? "--")

                                </td>


                                <td>

                                    @(employee.CheckOut?.ToString("hh:mm tt") ?? "--")

                                </td>


                                <td>

                                    <span class="badge @statusClass">

                                        @(employee.Status ?? "Unknown")

                                    </span>

                                </td>


                                <td>

                                    @(employee.Late > 0
                                        ? employee.Late.ToString()
                                        : "0")

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="5"
                                class="text-center text-muted py-4">

                                <i class="bi bi-calendar-x fs-3 d-block mb-2"></i>

                                No team attendance recorded for today.

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


