@model List<EventModel>


  <div class="row">
    <div class="col">
        <h2>Event List</h2>

        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a>
                    <i class="bi bi-house"></i>
                </a>
            </li>
            <li class="breadcrumb-item">Event</li>
            <li class="breadcrumb-item active">Event List</li>
        </ol>
    </div>

    <div class="col-auto">
        <button type="button" class="btn btn-warning"
                    data-bs-toggle="modal"
                    data-bs-target="#exampleModal">
            Add Holiday
        </button>
    </div>
</div>

<br/>
<br/>

@* Modal *@
<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="exampleModalLabel">Add New Event</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form method="post" asp-controller="Event" asp-action="AddActualEvent">

                    <label>Event Title</label>
                    <input type="text" name="Title" class="form-control" />

                    <br />
                    <br />

                    <label>Event Date</label>
                    <input type="date" name="Date" class="form-control" />

                    <br />
                    <br />


                   <label>Status</label>
                    <select name="Status" class="form-control">
                        <option value="">Select Status</option>
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>

                    <br />
                    <br />

                    <label>Event Type</label>
                    <select name="EventTypeId" class="form-control">
                        <option value="">Select Event Type</option>

                        @foreach (var item in ViewBag.EventTypes)
                        {
                            <option value="@item.Id">@item.Name</option>
                        }

                    </select>
                    <br />
                    <br />

                    <input type="submit" value="Add Event"/>

                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>


<div class="card">
    <div class="card-header">
        <h5>Event List</h5>
    </div>

    <div class="card-body">

        <table id="eventTable" class="table table-bordered">

            <thead>
                <tr>
                    <th>Id</th>
                    <th>Title</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Title</td>
                        <td>@item.Date.ToString("dd MMM yyyy")</td>
                        <td>

                            @if(@item.Status == "Active")
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }

                        </td>
                        <td>
                            <button data-bs-toggle="modal"
                                    data-bs-target="#updateModal"
                                    onclick="editEvent(
                                        '@item.Id',
                                        '@item.Title',
                                        '@item.Date.ToString("yyyy-MM-dd")',
                                        '@item.Status',
                                        '@item.EventTypeId'
                                 )">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <a asp-controller="Event"
                               asp-action="EventDelete"
                                asp-route-id="@item.Id">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>

        </table>

    </div>
</div>

@* Update Model *@

<div class="modal fade" id="updateModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="exampleModalLabel">Edit Event</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form method="post" asp-controller="Event" asp-action="updateEvent">

                    <input type="text" name="Id" id="editId"  hidden="hidden"/>

                    <br />

                    <label>Event Title</label>
                    <input type="text" name="Title" id="edittitle" class="form-control" />

                    <br />

                    <label>Event Date</label>
                    <input type="date" name="Date" id="editdate" class="form-control" />

                    <br />


                    <label>Status</label>
                    <select name="Status" id="editstatus" class="form-control">
                        <option value="">Select Status</option>
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>

                    <br />

                    <label>Event Type</label>
                    <select name="EventTypeId" id="editeventtypeid" class="form-control">
                        <option value="">Select Event Type</option>

                        @foreach (var item in ViewBag.EventTypes)
                        {
                            <option value="@item.Id">@item.Name</option>
                        }

                    </select>
                    <br />
                    <br />

                    <input type="submit" value="Update Event" />

                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>





@section Scripts
{
    <script>

         function editEvent(id, title,date, status, eventtypeid) {

            document.getElementById("editId").value = id;

            document.getElementById("edittitle").value = title;

            document.getElementById("editdate").value = date;

            document.getElementById("editstatus").value = status;

            document.getElementById("editeventtypeid").value = eventtypeid;

        }


        $(document).ready(function () {
            $('#eventTable').DataTable();
        });
    </script>

}