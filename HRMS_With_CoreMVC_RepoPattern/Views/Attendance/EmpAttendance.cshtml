@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

@model List<HRMS_With_CoreMVC_RepoPattern.Models.Attendance>
@{
    ViewData["Title"] = "Employee Attendance";
    var todayAttendance = ViewData["TodayAttendance"] as HRMS_With_CoreMVC_RepoPattern.Models.Attendance;
    var todayHours = Convert.ToDecimal(ViewData["TodayHours"] ?? 0);
    var weekHours = Convert.ToDecimal(ViewData["WeekHours"] ?? 0);
    var monthHours = Convert.ToDecimal(ViewData["MonthHours"] ?? 0);
    var overtimeHours = Convert.ToDecimal(ViewData["OvertimeHours"] ?? 0);
    var employeeName = todayAttendance?.User != null ? todayAttendance.User.FirstName + " " + todayAttendance.User.LastName : "Employee";
    var checkInDone = todayAttendance?.CheckIn != null;
    var lunchInDone = todayAttendance?.LunchIn != null;
    var lunchOutDone = todayAttendance?.LunchOut != null;
    var checkOutDone = todayAttendance?.CheckOut != null;
}

<style>
    body {
        background-color: #f7f8fa;
    }

    .attendance-page {
        padding: 30px 20px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

    .page-title {
        color: #16345f;
        font-weight: 700;
        font-size: 32px;
        margin-bottom: 5px;
    }

    .breadcrumb-text {
        color: #718096;
        font-size: 16px;
    }

    .top-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 22px;
        height: 100%;
        box-shadow: 0 2px 5px rgba(0,0,0,0.04);
    }

    .profile-card {
        text-align: center;
    }

    .profile-name {
        color: #16345f;
        font-size: 20px;
        font-weight: 600;
    }

    .current-time {
        color: #16345f;
        font-size: 24px;
        font-weight: 700;
    }

    .production-box {
        background: #ff641f;
        color: white;
        border-radius: 7px;
        padding: 10px;
        font-weight: 600;
        margin: 20px auto;
        width: 150px;
    }

    .attendance-button {
        background: #ff641f;
        color: white;
        border: none;
        padding: 12px 25px;
        border-radius: 7px;
        font-weight: 600;
        font-size: 17px;
    }

        .attendance-button:hover {
            background: #e95415;
            color: white;
        }

    .stat-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 25px;
        min-height: 180px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.04);
    }

    .stat-number {
        font-size: 30px;
        font-weight: 700;
        color: #16345f;
    }

    .stat-title {
        color: #718096;
        font-size: 17px;
        margin-top: 8px;
    }

    .chart-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 25px;
        margin-top: 25px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.04);
    }

    .legend {
        display: flex;
        justify-content: space-between;
        margin-bottom: 20px;
        flex-wrap: wrap;
        gap: 15px;
    }

    .legend-item {
        color: #718096;
        font-size: 16px;
    }

    .timeline {
        display: flex;
        gap: 8px;
        height: 30px;
        margin-top: 20px;
    }

    .productive {
        background: #00c853;
        flex: 5;
        border-radius: 5px;
    }

    .break-time {
        background: #ffbd00;
        flex: 1;
        border-radius: 5px;
    }

    .overtime {
        background: #2785ff;
        flex: 1;
        border-radius: 5px;
    }

    .attendance-history {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        margin-top: 30px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.04);
    }

    .history-header {
        padding: 25px;
        border-bottom: 1px solid #e2e8f0;
    }

    .history-title {
        color: #16345f;
        font-size: 20px;
        font-weight: 700;
    }

    .status-present {
        background: #00c853;
        color: white;
        padding: 5px 10px;
        border-radius: 5px;
        font-size: 13px;
        font-weight: 600;
    }

    .status-absent {
        background: #ef1010;
        color: white;
        padding: 5px 10px;
        border-radius: 5px;
        font-size: 13px;
        font-weight: 600;
    }

    .status-other {
        background: #ffbd00;
        color: white;
        padding: 5px 10px;
        border-radius: 5px;
        font-size: 13px;
        font-weight: 600;
    }

    table th {
        background: #edf0f4 !important;
        color: #111827;
        white-space: nowrap;
    }

    table td {
        vertical-align: middle;
        white-space: nowrap;
    }
</style>

<div class="container-fluid attendance-page">
    <div class="page-header">
        <div>
            <h1 class="page-title">Employee Attendance</h1>
            <div class="breadcrumb-text">Employee / Attendance</div>
        </div>
        <div>
            <button class="btn btn-outline-secondary">Export</button>
            <button class="btn btn-warning">Report</button>
        </div>
    </div>

    @if (TempData["success"] != null)
    {
        <div class="alert alert-success">@TempData["success"]</div>
    }

    <div class="row g-4">
        <div class="col-lg-3">
            <div class="top-card profile-card">
                <div class="profile-name">Good Morning, @employeeName</div>
                <div class="current-time mt-2">@DateTime.Now.ToString("hh.mm tt, dd MMM yyyy")</div>
                <div class="mt-4">
                    <div style="width:150px;height:150px;border-radius:50%;background:#e5e7eb;margin:auto;display:flex;align-items:center;justify-content:center;">
                        <span style="font-size:55px;color:#718096;">
                            <i class="bi bi-person"></i>
                        </span>
                    </div>
                </div>
                <div class="production-box">
                    Production :
                    <br />
                    @Math.Floor(todayAttendance?.ProductionHours ?? 0)h
                    @Math.Round(((todayAttendance?.ProductionHours ?? 0) % 1) * 60)min
                </div>
                <div class="mb-3">
                    @if (!checkInDone)
                    {
                        <span><i class="bi bi-fingerprint text-danger"></i> Punch In at Not Checked In</span>
                    }
                    else if (!lunchInDone)
                    {
                        <span><i class="bi bi-fingerprint text-success"></i> Checked In</span>
                    }
                    else if (!lunchOutDone)
                    {
                        <span><i class="bi bi-fingerprint text-warning"></i> Lunch Started</span>
                    }
                    else if (!checkOutDone)
                    {
                        <span><i class="bi bi-fingerprint text-success"></i> Working</span>
                    }
                    else
                    {
                        <span><i class="bi bi-check-circle text-success"></i> Checked Out</span>
                    }
                </div>

                @if (!checkInDone)
                {
                    <form asp-controller="EmpAttendance" asp-action="CheckIn" method="post">
                        <button type="submit" class="attendance-button">Check-In</button>
                    </form>
                }
                else if (!lunchInDone)
                {
                    <form asp-controller="EmpAttendance" asp-action="LunchIn" method="post">
                        <button type="submit" class="attendance-button">Lunch-In</button>
                    </form>
                }
                else if (!lunchOutDone)
                {
                    <form asp-controller="EmpAttendance" asp-action="LunchOut" method="post">
                        <button type="submit" class="attendance-button">Lunch-Out</button>
                    </form>
                }
                else if (!checkOutDone)
                {
                    <form asp-controller="EmpAttendance" asp-action="CheckOut" method="post">
                        <button type="submit" class="attendance-button">Check-Out</button>
                    </form>
                }
                else
                {
                    <button class="btn btn-secondary" disabled>Completed</button>
                }
            </div>
        </div>

        <div class="col-lg-9">
            <div class="row g-4">
                <div class="col-md-6 col-xl-3">
                    <div class="stat-card">
                        <div class="stat-number">@todayHours.ToString("0.00")</div>
                        <div class="stat-title">Total Hours Today</div>
                        <hr />
                        <span class="text-success"><i class="bi bi-arrow-up-circle-fill"></i> Today</span>
                    </div>
                </div>
                <div class="col-md-6 col-xl-3">
                    <div class="stat-card">
                        <div class="stat-number">@weekHours.ToString("0.00")</div>
                        <div class="stat-title">Total Hours Week</div>
                        <hr />
                        <span class="text-success"><i class="bi bi-arrow-up-circle-fill"></i> This Week</span>
                    </div>
                </div>
                <div class="col-md-6 col-xl-3">
                    <div class="stat-card">
                        <div class="stat-number">@monthHours.ToString("0.00")</div>
                        <div class="stat-title">Total Hours Month</div>
                        <hr />
                        <span class="text-danger"><i class="bi bi-arrow-down-circle-fill"></i> This Month</span>
                    </div>
                </div>
                <div class="col-md-6 col-xl-3">
                    <div class="stat-card">
                        <div class="stat-number">@overtimeHours.ToString("0.00")</div>
                        <div class="stat-title">Overtime this Month</div>
                        <hr />
                        <span class="text-danger"><i class="bi bi-arrow-down-circle-fill"></i> This Month</span>
                    </div>
                </div>
            </div>

            <div class="chart-card">
                <div class="legend">
                    <div class="legend-item">
                        ● Total Working hours
                        <br />
                        <strong class="text-dark">@todayHours.ToString("0.00")h</strong>
                    </div>
                    <div class="legend-item">
                        <span class="text-success">●</span> Productive Hours
                        <br />
                        <strong class="text-dark">@(todayAttendance?.ProductionHours.ToString("0.00") ?? "0.00")h</strong>
                    </div>
                    <div class="legend-item">
                        <span style="color:#ffbd00">●</span> Break hours
                        <br />
                        <strong class="text-dark">@(todayAttendance?.BreakHours.ToString("0.00") ?? "0.00")h</strong>
                    </div>
                    <div class="legend-item">
                        <span class="text-primary">●</span> Overtime
                        <br />
                        <strong class="text-dark">@(todayAttendance?.OvertimeHours.ToString("0.00") ?? "0.00")h</strong>
                    </div>
                </div>

                <div class="timeline">
                    <div class="productive"></div>
                    <div class="break-time"></div>
                    <div class="productive"></div>
                    <div class="break-time"></div>
                    <div class="productive"></div>
                    <div class="overtime"></div>
                    <div class="overtime"></div>
                </div>

                <div class="d-flex justify-content-between text-muted mt-3">
                    <span>06:00</span><span>07:00</span><span>08:00</span><span>09:00</span><span>10:00</span>
                    <span>11:00</span><span>12:00</span><span>01:00</span><span>02:00</span><span>03:00</span>
                    <span>04:00</span><span>05:00</span><span>06:00</span><span>07:00</span><span>08:00</span>
                    <span>09:00</span><span>10:00</span><span>11:00</span>
                </div>
            </div>
        </div>
    </div>

    <div class="attendance-history">
        <div class="history-header">
            <div class="row align-items-end g-3">
                <div class="col-md-3">
                    <div class="history-title">Employee Attendance</div>
                </div>
                <div class="col-md-2">
                    <label>Start:</label>
                    <input type="date" id="startDate" class="form-control" value="@ViewData["StartDate"]" />
                </div>
                <div class="col-md-2">
                    <label>End:</label>
                    <input type="date" id="endDate" class="form-control" value="@ViewData["EndDate"]" />
                </div>
                <div class="col-md-2">
                    <label>Status:</label>
                    <select id="status" class="form-select">
                        <option value="All">Select Status</option>
                        <option value="Present">Present</option>
                        <option value="Absent">Absent</option>
                        <option value="Permission">Permission</option>
                        <option value="Uninformed">Uninformed</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label>Sort:</label>
                    <select id="sort" class="form-select">
                        <option value="Recently">Recently Added</option>
                        <option value="Oldest">Oldest First</option>
                    </select>
                </div>
            </div>

            <div class="row mt-3">
                <div class="col-md-4 ms-auto">
                    <input type="text" id="search" class="form-control" placeholder="Search" />
                </div>
                <div class="col-md-2">
                    <button type="button" onclick="searchAttendance()" class="btn btn-primary w-100">Search</button>
                </div>
                <div class="col-md-2">
                    <button type="button" onclick="clearSearch()" class="btn btn-secondary w-100">Clear</button>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered mb-0">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Check In</th>
                        <th>Status</th>
                        <th>Check Out</th>
                        <th>Break</th>
                        <th>Late</th>
                        <th>Overtime</th>
                        <th>Production Hours</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Date.ToString("yyyy-MM-dd")</td>
                                <td>@(item.CheckIn?.ToString("hh:mm tt") ?? "")</td>
                                <td>
                                    @if (item.Status == "Present")
                                    {
                                        <span class="status-present">● Present</span>
                                    }
                                    else if (item.Status == "Absent")
                                    {
                                        <span class="status-absent">● Absent</span>
                                    }
                                    else
                                    {
                                        <span class="status-other">● @item.Status</span>
                                    }
                                </td>
                                <td>@(item.CheckOut?.ToString("hh:mm tt") ?? "")</td>
                                <td>@item.BreakHours.ToString("0.00") hrs</td>
                                <td>@item.Late min</td>
                                <td>@item.OvertimeHours.ToString("0.00") hrs</td>
                                <td>
                                    @if (item.ProductionHours > 0)
                                    {
                                        <span class="status-present">● @item.ProductionHours.ToString("0.00")</span>
                                    }
                                    else
                                    {
                                        <span class="status-absent">● 0.00</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center p-4">No attendance records found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function searchAttendance() {
        var startDate = document.getElementById("startDate").value;
        var endDate = document.getElementById("endDate").value;
        var status = document.getElementById("status").value;
        var sort = document.getElementById("sort").value;
        var search = document.getElementById("search").value;
        var url = "/EmpAttendance/Index?" +
            "startDate=" + encodeURIComponent(startDate) +
            "&endDate=" + encodeURIComponent(endDate) +
            "&status=" + encodeURIComponent(status) +
            "&sort=" + encodeURIComponent(sort) +
            "&search=" + encodeURIComponent(search);
        window.location.href = url;
    }

    function clearSearch() {
        window.location.href = "/EmpAttendance/Index";
    }
</script>