@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

@model List<HRMS_With_CoreMVC_RepoPattern.Models.Attendance>
@{
    ViewData["Title"] = "Attendance Admin";
    var departments = ViewBag.Departments as List<HRMS_With_CoreMVC_RepoPattern.Models.Department>;
    var totalEmployees = ViewBag.TotalEmployees ?? 0;
    var present = ViewBag.Present ?? 0;
    var late = ViewBag.Late ?? 0;
    var uninformed = ViewBag.Uninformed ?? 0;
    var permission = ViewBag.Permission ?? 0;
    var absent = ViewBag.Absent ?? 0;
}

<style>
    .attendance-page {
        padding: 25px 20px;
    }

    .page-header {
        margin-bottom: 28px;
    }

    .page-title {
        font-size: 32px;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .breadcrumb-text {
        color: #6c757d;
        font-size: 15px;
    }

    .top-buttons .btn {
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: 500;
    }

    .summary-card, .attendance-card {
        border: 1px solid #e1e5ea;
        border-radius: 12px;
        background: white;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }

    .summary-card {
        margin-bottom: 28px;
    }

    .summary-header {
        padding: 25px 28px 10px;
    }

    .summary-title {
        font-size: 25px;
        font-weight: 700;
    }

    .summary-subtitle {
        color: #6c757d;
    }

    .total-absent {
        text-align: right;
    }

    .total-absent-title {
        font-weight: 600;
        font-size: 16px;
    }

    .total-absent-value {
        font-size: 24px;
        font-weight: 700;
    }

    .summary-items {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        margin: 15px 28px 28px;
        border: 1px solid #e1e5ea;
        border-radius: 8px;
        overflow: hidden;
    }

    .summary-item {
        padding: 22px;
        border-right: 1px solid #e1e5ea;
        background: #fff;
    }

        .summary-item:last-child {
            border-right: none;
        }

    .summary-label {
        color: #5f6b7a;
        font-size: 15px;
        margin-bottom: 8px;
    }

    .summary-number {
        font-size: 25px;
        font-weight: 700;
        margin: 0;
    }

    .attendance-card {
        overflow: hidden;
    }

    .attendance-card-header {
        padding: 25px 28px;
        border-bottom: 1px solid #e1e5ea;
    }

    .attendance-heading {
        font-size: 24px;
        font-weight: 700;
        margin: 0;
    }

    .filter-label {
        font-size: 14px;
        font-weight: 500;
        color: #596575;
        margin-bottom: 7px;
    }

    .filter-control {
        height: 46px;
        border: 1px solid #d9dee5;
        border-radius: 7px;
        padding: 8px 12px;
        font-size: 15px;
    }

    .table-controls {
        padding: 18px 28px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .rows-control {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #596575;
    }

    .rows-select {
        width: 95px;
        height: 42px;
        border: 1px solid #d9dee5;
        border-radius: 7px;
    }

    .search-box {
        width: 280px;
        height: 42px;
        border: 1px solid #d9dee5;
        border-radius: 7px;
        padding: 8px 14px;
    }

    .attendance-table {
        margin: 0 28px 28px;
        width: calc(100% - 56px);
        border-collapse: separate;
        border-spacing: 0;
    }

        .attendance-table thead th {
            background: #e9edf2;
            color: #172033;
            font-weight: 600;
            padding: 15px 12px;
            white-space: nowrap;
            border-bottom: 1px solid #172033;
        }

        .attendance-table tbody td {
            padding: 16px 12px;
            border-bottom: 1px solid #e5e8ec;
            font-size: 14px;
            vertical-align: middle;
            white-space: nowrap;
        }

        .attendance-table tbody tr:hover {
            background: #f8f9fb;
        }

    .employee-name {
        font-weight: 600;
        color: #344054;
    }

    .employee-department {
        font-size: 12px;
        color: #8a94a3;
        margin-top: 3px;
    }

    .status-badge {
        display: inline-block;
        padding: 5px 11px;
        border-radius: 5px;
        font-size: 12px;
        font-weight: 600;
    }

    .status-present {
        background: #d1f7df;
        color: #087a3d;
    }

    .status-absent {
        background: #ffd9d9;
        color: #c62828;
    }

    .status-permission {
        background: #fff0c2;
        color: #856404;
    }

    .status-uninformed {
        background: #ffe1cc;
        color: #b94a00;
    }

    .status-late {
        background: #fff0c2;
        color: #856404;
    }

    .status-default {
        background: #e8edf3;
        color: #4b5563;
    }

    .production-badge {
        background: #ffe0e0;
        color: #e00000;
        padding: 5px 10px;
        border-radius: 5px;
        font-weight: 600;
    }

    .dataTables_wrapper {
        margin: 0 28px 25px;
    }

        .dataTables_wrapper .dataTables_filter {
            display: none;
        }

        .dataTables_wrapper .dataTables_length {
            display: none;
        }

        .dataTables_wrapper .dataTables_info {
            color: #596575;
            padding-top: 15px;
        }

        .dataTables_wrapper .dataTables_paginate {
            padding-top: 15px;
        }

            .dataTables_wrapper .dataTables_paginate .paginate_button {
                border: 1px solid #dee2e6 !important;
                background: white !important;
                padding: 6px 12px !important;
                margin-left: 4px !important;
                border-radius: 5px !important;
            }

                .dataTables_wrapper .dataTables_paginate .paginate_button.current {
                    background: #0d6efd !important;
                    color: white !important;
                    border-color: #0d6efd !important;
                }

                .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
                    background: #0d6efd !important;
                    color: white !important;
                    border-color: #0d6efd !important;
                }

                .dataTables_wrapper .dataTables_paginate .paginate_button.disabled {
                    color: #999 !important;
                    background: #f8f9fa !important;
                }

    .dt-buttons {
        display: none;
    }

    .empty-row {
        text-align: center;
        padding: 35px !important;
        color: #7b8491;
    }

    @@media (max-width: 992px) {
        .summary-items {
            grid-template-columns: repeat(2, 1fr);
        }

        .summary-item {
            border-bottom: 1px solid #e1e5ea;
        }

        .table-controls {
            flex-wrap: wrap;
            gap: 15px;
        }

        .search-box {
            width: 100%;
        }
    }

    @@media (max-width: 768px) {
        .attendance-page {
            padding: 15px 10px;
        }

        .page-header {
            display: block !important;
        }

        .top-buttons {
            margin-top: 15px;
        }

        .summary-items {
            grid-template-columns: 1fr;
        }

        .summary-item {
            border-right: none;
        }

        .total-absent {
            text-align: left;
            margin-top: 15px;
        }

        .attendance-table {
            margin: 0 10px 20px;
            width: calc(100% - 20px);
        }

        .dataTables_wrapper {
            margin: 0 10px 20px;
        }
    }
</style>

<div class="attendance-page">
    <div class="page-header d-flex justify-content-between align-items-center">
        <div>
            <div class="page-title">Attendance Admin</div>
            <div class="breadcrumb-text">Employee <span class="mx-2">/</span> Attendance Admin</div>
        </div>

        <div class="top-buttons d-flex">
            <div class="dropdown me-2">
                <button class="btn btn-light border dropdown-toggle" type="button" data-bs-toggle="dropdown">
                    <i class="bi bi-file-earmark-arrow-down"></i> Export
                </button>
                <ul class="dropdown-menu">
                    <li>
                        <a href="#" class="dropdown-item" id="excelBtn">
                            <i class="bi bi-file-earmark-excel"></i> Export as Excel
                        </a>
                    </li>
                    <li>
                        <a href="#" class="dropdown-item" id="pdfBtn">
                            <i class="bi bi-file-earmark-pdf"></i> Export as PDF
                        </a>
                    </li>
                    <li>
                        <a href="#" class="dropdown-item" id="printBtn">
                            <i class="bi bi-printer"></i> Print
                        </a>
                    </li>
                </ul>
            </div>

            <button class="btn btn-warning">
                <i class="bi bi-file-earmark-bar-graph"></i> Report
            </button>
        </div>
    </div>

    <div class="summary-card">
        <div class="summary-header">
            <div class="d-flex justify-content-between">
                <div>
                    <div class="summary-title">Attendance Details Today</div>
                    <p class="summary-subtitle">Data from the @totalEmployees total no of employees</p>
                </div>

                <div class="total-absent">
                    <div class="total-absent-title">Total Absentees Today</div>
                    <div class="total-absent-value">@absent</div>
                </div>
            </div>
        </div>

        <div class="summary-items">
            <div class="summary-item">
                <div class="summary-label">Present</div>
                <p class="summary-number">@present</p>
            </div>
            <div class="summary-item">
                <div class="summary-label">Late Login</div>
                <p class="summary-number">@late</p>
            </div>
            <div class="summary-item">
                <div class="summary-label">Uninformed</div>
                <p class="summary-number">@uninformed</p>
            </div>
            <div class="summary-item">
                <div class="summary-label">Permission</div>
                <p class="summary-number">@permission</p>
            </div>
            <div class="summary-item">
                <div class="summary-label">Absent</div>
                <p class="summary-number">@absent</p>
            </div>
        </div>
    </div>

    <div class="attendance-card">
        <div class="attendance-card-header">
            <form method="get" asp-action="AdminAttendanceList">
                <div class="row align-items-end">
                    <div class="col-lg-2 col-md-12 mb-3 mb-lg-0">
                        <div class="attendance-heading">Admin Attendance</div>
                    </div>

                    <div class="col-lg-2 col-md-6 mb-3 mb-lg-0">
                        <label class="filter-label">Start Date:</label>
                        <input type="date" name="startDate" value="@Context.Request.Query["startDate"]" class="form-control filter-control" />
                    </div>

                    <div class="col-lg-2 col-md-6 mb-3 mb-lg-0">
                        <label class="filter-label">End Date:</label>
                        <input type="date" name="endDate" value="@Context.Request.Query["endDate"]" class="form-control filter-control" />
                    </div>

                    <div class="col-lg-2 col-md-6 mb-3 mb-lg-0">
                        <label class="filter-label">Department</label>
                        <select name="departmentId" class="form-control filter-control">
                            <option value="">All Departments</option>
                            @if (departments != null)
                            {
                                foreach (var department in departments)
                                {
                                    <option value="@department.DepartmentId" selected="@(Context.Request.Query["departmentId"] == department.DepartmentId.ToString())">@department.Name</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-lg-2 col-md-6 mb-3 mb-lg-0">
                        <label class="filter-label">Status</label>
                        <select name="status" class="form-control filter-control">
                            <option value="All" selected="@(string.IsNullOrEmpty(Context.Request.Query["status"]) || Context.Request.Query["status"] == "All")">All</option>
                            <option value="Present">Present</option>
                            <option value="Absent">Absent</option>
                            <option value="Late">Late</option>
                            <option value="Permission">Permission</option>
                            <option value="Uninformed">Uninformed</option>
                        </select>
                    </div>

                    <div class="col-lg-2 col-md-6 mb-3 mb-lg-0">
                        <label class="filter-label">Sort</label>
                        <select name="sort" class="form-control filter-control">
                            <option value="Recently Added">Recently Added</option>
                            <option value="Oldest First">Oldest First</option>
                        </select>
                    </div>
                </div>

                <div class="row mt-3">
                    <div class="col-12 d-flex justify-content-end gap-2">
                        <input type="text" name="search" value="@Context.Request.Query["search"]" class="search-box" placeholder="Search Employee" />
                        <button type="submit" class="btn btn-primary">Search</button>
                        <a asp-action="AdminAttendanceList" class="btn btn-secondary">Clear</a>
                    </div>
                </div>
            </form>
        </div>

        <div class="table-controls">
            <div class="rows-control">
                <span>Rows</span>
                <select id="rowsPerPage" class="rows-select">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
                <span>Entries</span>
            </div>
            <div>
                <span id="entryInfo"></span>
            </div>
        </div>

        <div class="table-responsive">
            <table class="attendance-table" id="attendanceTable">
                <thead>
                    <tr>
                        <th>AId</th>
                        <th>Date</th>
                        <th>Employee</th>
                        <th>Status</th>
                        <th>Check In</th>
                        <th>Check Out</th>
                        <th>Break</th>
                        <th>Late</th>
                        <th>Production Hours</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.AttendanceId</td>
                                <td>@item.Date.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <div class="employee-name">@item.User?.FirstName @item.User?.LastName</div>
                                    <div class="employee-department">@item.User?.Department?.Name</div>
                                </td>
                                <td>
                                    @if (item.Status == "Present")
                                    {
                                        <span class="status-badge status-present">● Present</span>
                                    }
                                    else if (item.Status == "Absent")
                                    {
                                        <span class="status-badge status-absent">● Absent</span>
                                    }
                                    else if (item.Status == "Permission")
                                    {
                                        <span class="status-badge status-permission">● Permission</span>
                                    }
                                    else if (item.Status == "Uninformed")
                                    {
                                        <span class="status-badge status-uninformed">● Uninformed</span>
                                    }
                                    else if (item.Status == "Late")
                                    {
                                        <span class="status-badge status-late">● Late</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-default">● @item.Status</span>
                                    }
                                </td>
                                <td>@(item.CheckIn?.ToString("hh:mm tt") ?? "-")</td>
                                <td>@(item.CheckOut?.ToString("hh:mm tt") ?? "-")</td>
                                <td>@item.BreakHours.ToString("0.00") hrs</td>
                                <td>@item.Late min</td>
                                <td>
                                    <span class="production-badge">@item.ProductionHours.ToString("0.00")</span>
                                </td>
                                <td>
                                    <a asp-action="EditAttendance" asp-route-id="@item.AttendanceId" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="empty-row">No attendance records found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/jquery.dataTables.min.css" />
<link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.dataTables.min.css" />

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>

<script>
    $(document).ready(function() {
        var table = $('#attendanceTable').DataTable({
            pageLength: 10,
            ordering: true,
            searching: true,
            lengthChange: false,
            autoWidth: false,
            order: [[1, 'desc']],
            columnDefs: [
                {
                    orderable: false,
                    targets: 9
                }
            ],
            dom: 'rtip',
            buttons: [
                {
                    extend: 'excelHtml5',
                    title: 'Admin Attendance'
                },
                {
                    extend: 'pdfHtml5',
                    title: 'Admin Attendance',
                    orientation: 'landscape',
                    pageSize: 'A4'
                },
                {
                    extend: 'print',
                    title: 'Admin Attendance'
                }
            ]
        });

        $('#rowsPerPage').change(function() {
            table.page.len(parseInt(this.value)).draw();
        });

        $('#excelBtn').click(function(e) {
            e.preventDefault();
            table.button('.buttons-excel').trigger();
        });

        $('#pdfBtn').click(function(e) {
            e.preventDefault();
            table.button('.buttons-pdf').trigger();
        });

        $('#printBtn').click(function(e) {
            e.preventDefault();
            table.button('.buttons-print').trigger();
        });
    });
</script>