@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@model List<HRMS_With_CoreMVC_RepoPattern.Models.Promotion>

@{
    ViewData["Title"] = "Promotions";
}

<h2>Promotion Management</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

<button class="btn btn-primary mb-3" data-bs-toggle="modal" data-bs-target="#addModal">
    Add Promotion
</button>

<table id="promotionTable" class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>User ID</th>
            <th>From</th>
            <th>To</th>
            <th>Date</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.UserID</td>
                <td>@item.DesignationFrom</td>
                <td>@item.DesignationTo</td>
                <td>@item.Date.ToString("dd-MMM-yyyy")</td>
                <td>
                    <button class="btn btn-sm btn-warning"
                            data-bs-toggle="modal"
                            data-bs-target="#editModal"
                            onclick="loadEditModal(@item.PromotionId, @item.UserID, '@item.DesignationFrom', '@item.DesignationTo', '@item.Date.ToString("yyyy-MM-dd")')">
                        Edit
                    </button>
                    <form asp-action="Delete" method="post" style="display:inline;" onsubmit="return confirm('Delete this promotion?');">
                        <input type="hidden" name="id" value="@item.PromotionId" />
                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Add Modal -->
<div class="modal fade" id="addModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Add" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Add Promotion</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label>Employee</label>
                        <select name="UserID" class="form-select" required>
                            <option value="">Select Employee</option>
                            @foreach (var user in ViewBag.User as List<HRMS_With_CoreMVC_RepoPattern.Models.User>)
                            {
                                <option value="@user.UserId">@user.FirstName</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label>Designation From</label>
                        <select name="DesignationFrom" class="form-select" required>
                            <option value="">Select Designation</option>
                            @foreach (var d in ViewBag.Designation as List<HRMS_With_CoreMVC_RepoPattern.Models.Designation>)
                            {
                                <option value="@d.Name">@d.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label>Designation To</label>
                        <select name="DesignationTo" class="form-select" required>
                            <option value="">Select Designation</option>
                            @foreach (var d in ViewBag.Designation as List<HRMS_With_CoreMVC_RepoPattern.Models.Designation>)
                            {
                                <option value="@d.Name">@d.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label>Date</label>
                        <input type="date" name="Date" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Edit" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Promotion</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="PromotionId" id="editPromotionId" />
                    <div class="mb-3">
                        <label>Employee</label>
                        <select name="UserID" id="editUserID" class="form-select" required>
                            <option value="">Select Employee</option>
                            @foreach (var user in ViewBag.User as List<HRMS_With_CoreMVC_RepoPattern.Models.User>)
                            {
                                <option value="@user.UserId">@user.FirstName</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label>Designation From</label>
                        <select name="DesignationFrom" id="editDesignationFrom" class="form-select" required>
                            <option value="">Select Designation</option>
                            @foreach (var d in ViewBag.Designation as List<HRMS_With_CoreMVC_RepoPattern.Models.Designation>)
                            {
                                <option value="@d.Name">@d.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label>Designation To</label>
                        <select name="DesignationTo" id="editDesignationTo" class="form-select" required>
                            <option value="">Select Designation</option>
                            @foreach (var d in ViewBag.Designation as List<HRMS_With_CoreMVC_RepoPattern.Models.Designation>)
                            {
                                <option value="@d.Name">@d.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label>Date</label>
                        <input type="date" name="Date" id="editDate" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Update</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#promotionTable').DataTable();
        });

        function loadEditModal(id, userId, from, to, date) {
            $('#editPromotionId').val(id);
            $('#editUserID').val(userId);
            $('#editDesignationFrom').val(from);
            $('#editDesignationTo').val(to);
            $('#editDate').val(date);
        }
    </script>
}