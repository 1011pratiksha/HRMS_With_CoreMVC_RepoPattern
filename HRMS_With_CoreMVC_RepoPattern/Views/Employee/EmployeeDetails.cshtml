<!-- edit emp profile -->

<div class="modal fade"
     id="editEmployeeProfileModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Edit Employee Information
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <form asp-action="EditEmployeeProfile"
                  asp-controller="Employee"
                  method="post">

                <div class="modal-body">

                    <input type="hidden"
                           name="UserId"
                           value="@Model.UserId" />

                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                First Name
                            </label>

                            <input type="text"
                                   name="FirstName"
                                   class="form-control"
                                   value="@Model.FirstName"
                                   required />

                        </div>

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Last Name
                            </label>

                            <input type="text"
                                   name="LastName"
                                   class="form-control"
                                   value="@Model.LastName"
                                   required />

                        </div>

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Phone Number
                            </label>

                            <input type="text"
                                   name="PhoneNumber"
                                   class="form-control"
                                   value="@Model.PhoneNumber" />

                        </div>

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Date of Joining
                            </label>

                            <input type="date"
                                   name="DateOfJoining"
                                   class="form-control"
                                   value="@(Model.DateOfJoining?.ToString("yyyy-MM-dd"))" />

                        </div>

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Date of Birth
                            </label>

                            <input type="date"
                                   name="DateOfBirth"
                                   class="form-control"
                                   value="@(Model.DateOfBirth?.ToString("yyyy-MM-dd"))" />

                        </div>

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Gender
                            </label>

                            <input type="text"
                                   name="Gender"
                                   class="form-control"
                                   value="@Model.Gender" />

                        </div>

                        <div class="col-md-12 mb-3">

                            <label class="form-label">
                                Address
                            </label>

                            <textarea name="Address"
                                      class="form-control"
                                      rows="2">@Model.Address</textarea>

                        </div>

                        <div class="col-md-12 mb-3">

                            <label class="form-label">
                                About Employee
                            </label>

                            <textarea name="AboutEmployee"
                                      class="form-control"
                                      rows="4">@Model.AboutEmployee</textarea>

                        </div>

                        <div class="col-md-12 mb-3">

                            <label class="form-label">
                                Reporting Manager
                            </label>

                            <input type="text"
                                   name="ReportingManager"
                                   class="form-control"
                                   value="@Model.ReportingManager" />

                        </div>

                        <input type="hidden"
                               name="ProfilePicture"
                               value="@Model.ProfilePicture" />

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-primary">
                        Update
                    </button>

                </div>

            </form>

        </div>
</div>


</div>
