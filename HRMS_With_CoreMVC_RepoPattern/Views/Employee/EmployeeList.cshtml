        {
            <img src="@item.ProfilePicture"
                 alt="@item.FirstName @item.LastName"
                 class="rounded-circle me-2"
                 style="width:45px;height:45px;object-fit:cover;" />
        }
        else
        {
            <div class="rounded-circle bg-secondary text-white
