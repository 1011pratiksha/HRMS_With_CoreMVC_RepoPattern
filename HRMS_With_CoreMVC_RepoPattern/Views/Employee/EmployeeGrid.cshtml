@{
}

@model List<HRMS_With_CoreMVC_RepoPattern.Models.EmployeeGridViewModel>

@{
    ViewData["Title"] = "Employee Grid";
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">


<div class="container-fluid">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1">Employee</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item">
                        <a href="#" class="text-decoration-none">
                            Home
                        </a>
                    </li>
                    <li class="breadcrumb-item">
                        Employee
                    </li>
                    <li class="breadcrumb-item active">
                        Employee Grid
                    </li>
                </ol>
            </nav>
        </div>

        <!-- Add Employee -->
        <button type="button"
                class="btn"
                style="background-color:#f5820d;color:#fff;"
                data-bs-toggle="modal"
                data-bs-target="#addEmployeeModal">

            <i class="bi bi-plus-circle me-1"></i>
            Add Employee
        </button>

    </div>

    <!-- Summary Cards -->
    <div class="row mb-4">

        <!-- Total -->
        <div class="col-md-3 mb-3">

            <div class="card shadow-sm h-100">

                <div class="card-body d-flex align-items-center">

                    <div class="rounded-circle d-flex align-items-center justify-content-center me-3"
                         style="width:50px;height:50px;background-color:#fff1e5;">

                        <i class="bi bi-people-fill fs-4"
                           style="color:#f5820d;"></i>

                    </div>

                    <div>
                        <h6 class="text-muted mb-1">
                            Total Employee
                        </h6>
                        <h4 class="mb-0">
                            @Model.Count
                        </h4>
                    </div>
                </div>
            </div>
        </div>

        <!-- Active -->
        <div class="col-md-3 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle d-flex align-items-center justify-content-center me-3"
                         style="width:50px;height:50px;background-color:#e8f7ee;">
                        <i class="bi bi-person-check-fill fs-4 text-success"></i>
                    </div>
                    <div>
                        <h6 class="text-muted mb-1">
                            Active
                        </h6>
                        <h4 class="mb-0">
                            @Model.Count(x => x.Status == "Active")
                        </h4>
                    </div>
                </div>
            </div>
        </div>

        <!-- Inactive -->
        <div class="col-md-3 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle d-flex align-items-center justify-content-center me-3"
                         style="width:50px;height:50px;background-color:#fdeaea;">
                        <i class="bi bi-person-x-fill fs-4 text-danger"></i>
                    </div>
                    <div>
                        <h6 class="text-muted mb-1">
                            Inactive
                        </h6>
                        <h4 class="mb-0">
                            @Model.Count(x => x.Status != "Active")
                        </h4>
                    </div>
                </div>
            </div>
        </div>


        <!-- New Joiners -->
        <div class="col-md-3 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle d-flex align-items-center justify-content-center me-3"
                         style="width:50px;height:50px;background-color:#fff1e5;">
                        <i class="bi bi-person-plus-fill fs-4"
                           style="color:#f5820d;"></i>
                    </div>
                    <div>
                        <h6 class="text-muted mb-1">
                            New Joiners
                        </h6>
                        <h4 class="mb-0">
                            @Model.Count(x =>
                                x.UserId > 0)
                        </h4>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Employee List -->
    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    Employee List
                </h5>
                <span class="text-muted">
                    @Model.Count Employee(s)
                </span>
            </div>
        </div>
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="row">
                    @foreach (var employee in Model)
                    {
                        <div class="col-xl-4 col-lg-6 col-md-6 mb-4">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body">
                                    <!-- Employee Profile -->
                                    <div class="d-flex align-items-center mb-4">
                                        @if (!string.IsNullOrEmpty(employee.ProfilePicture))
                                        {
                                            <img src="@employee.ProfilePicture"
                                                 alt="Profile"
                                                 class="rounded-circle me-3"
                                                 style="width:65px;height:65px;object-fit:cover;">
                                        }
                                        else
                                        {
                                            <div class="rounded-circle d-flex align-items-center justify-content-center me-3"
                                                 style="width:65px;height:65px;background-color:#f5820d;color:white;font-size:24px;">

                                                @(employee.FirstName?.Length > 0
                                                    ? employee.FirstName.Substring(0, 1).ToUpper()
                                                    : "?")
                                            </div>
                                        }
                                        <div>
                                            <h5 class="mb-1">
                                                @employee.FirstName @employee.LastName
                                            </h5>
                                            <p class="text-muted mb-0">
                                                @(employee.DesignationName ?? "No Designation")
                                            </p>
                                        </div>
                                    </div>

                                    <!-- Project / Task Statistics -->
                                    <div class="row text-center mb-4">
                                        <!-- Projects -->
                                        <div class="col-4">
                                            <div class="fw-bold fs-5">
                                                @employee.TotalProjects
                                            </div>
                                            <small class="text-muted">
                                                Projects
                                            </small>
                                        </div>
                                        <!-- Done -->
                                        <div class="col-4">
                                            <div class="fw-bold fs-5 text-success">
                                                @employee.CompletedTasks
                                            </div>
                                            <small class="text-muted">
                                                Done
                                            </small>
                                        </div>
                                        <!-- Progress -->
                                        <div class="col-4">
                                            <div class="fw-bold fs-5"
                                                 style="color:#f5820d;">
                                                @employee.InProgressTasks
                                            </div>
                                            <small class="text-muted">
                                                Progress
                                            </small>
                                        </div>
                                    </div>
                                    <!-- Pending -->
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <span class="text-muted">
                                            <i class="bi bi-hourglass-split me-1"></i>
                                            Pending
                                        </span>

                                        <span class="fw-bold">
                                            @employee.PendingTasks
                                        </span>
                                    </div>

                                    <!-- Productivity -->
                                    <div class="mb-4">
                                        <div class="d-flex justify-content-between mb-1">
                                            <span class="text-muted">
                                                Productivity
                                            </span>
                                            <span class="fw-bold">
                                                @employee.Productivity%
                                            </span>
                                        </div>

                                        <div class="progress"
                                             style="height:8px;">

                                            <div class="progress-bar"
                                                 role="progressbar"
                                                 style="width:@employee.Productivity%;background-color:#f5820d;"
                                                 aria-valuenow="@employee.Productivity"
                                                 aria-valuemin="0"
                                                 aria-valuemax="100">
                                            </div>

                                        </div>

                                    </div>


                                    <!-- Status -->
                                    <div class="d-flex justify-content-between align-items-center">

                                        <span class="text-muted">
                                            Status
                                        </span>


                                        @if (employee.Status == "Active")
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-circle-fill me-1"
                                                   style="font-size:7px;"></i>
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                <i class="bi bi-circle-fill me-1"
                                                   style="font-size:7px;"></i>
                                                Inactive
                                            </span>
                                        }

                                    </div>

                                </div>

                            </div>

                        </div>
                    }

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-people fs-1 text-muted"></i>

                    <h5 class="mt-3">
                        No Employees Found
                    </h5>

                </div>
            }

        </div>

    </div>

</div>


<!-- ================================================= -->
<!-- ADD EMPLOYEE MODAL -->
<!-- ================================================= -->

<div class="modal fade"
     id="addEmployeeModal"
     tabindex="-1">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Add New Employee
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <div class="modal-body">

                <form method="post"
      asp-controller="Employee"
      asp-action="AddEmployee"
      enctype="multipart/form-data">

                      <div class="col-md-6 mb-3">

    <label class="form-label">
        Profile Picture
    </label>

    <input type="file"
       name="profilePicture"
       class="form-control"
       accept="image/*" />

</div>
                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                First Name
                            </label>

                            <input type="text"
                                   name="FirstName"
                                   class="form-control"
                                   required />

                        </div>


                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Last Name
                            </label>

                            <input type="text"
                                   name="LastName"
                                   class="form-control"
                                   required />

                        </div>


                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Email
                            </label>

                            <input type="email"
                                   name="Email"
                                   class="form-control"
                                   required />

                        </div>


                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Password
                            </label>

                            <input type="password"
                                   name="PasswordHash"
                                   class="form-control"
                                   required />

                        </div>


                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Joining Date
                            </label>

                            <input type="date"
                                   name="DateOfJoining"
                                   class="form-control"
                                   required />

                        </div>


                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Birth Date
                            </label>

                            <input type="date"
                                   name="DateOfBirth"
                                   class="form-control"
                                   required />

                        </div>


                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Role
                            </label>

                            <select name="RoleId"
                                    class="form-select"
                                    required>

                                <option value="">
                                    Select Role
                                </option>

                                @foreach (var role in ViewBag.Roles)
                                {
                                    <option value="@role.RoleId">
                                        @role.RoleName
                                    </option>
                                }

                            </select>

                        </div>


                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Department
                            </label>

                            <select name="DepartmentId"
                                    class="form-select"
                                    required>

                                <option value="">
                                    Select Department
                                </option>

                                @foreach (var dept in ViewBag.Departments)
                                {
                                    <option value="@dept.DepartmentId">
                                        @dept.Name
                                    </option>
                                }

                            </select>

                        </div>


                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Manager
                            </label>

                            <select name="ReportingManager"
                                    class="form-select">

                                <option value="">
                                    Select Manager
                                </option>

                                @foreach (var user in ViewBag.Users)
                                {
                                    <option value="@user.UserId">
                                        @user.FirstName @user.LastName
                                    </option>
                                }

                            </select>
                        </div>


                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Designation
                            </label>

                            <select name="DesignationId"
                                    class="form-select"
                                    required>

                                <option value="">
                                    Select Designation
                                </option>

                                @foreach (var designation in ViewBag.Designations)
                                {
                                    <option value="@designation.DesignationId">
                                        @designation.Name
                                    </option>
                                }

                            </select>

                        </div>


                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Phone Number
                            </label>

                            <input type="tel"
                                   name="PhoneNumber"
                                   class="form-control"
                                   required />

                        </div>


                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Address
                            </label>

                            <input type="text"
                                   name="Address"
                                   class="form-control"
                                   required />

                        </div>


                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Gender
                            </label>

                            <select name="Gender"
                                    class="form-select"
                                    required>

                                <option value="">
                                    Select Gender
                                </option>

                                <option value="Male">
                                    Male
                                </option>

                                <option value="Female">
                                    Female
                                </option>

                            </select>

                        </div>


                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Status
                            </label>

                            <select name="status"
                                    class="form-select"
                                    required>

                                <option value="">
                                    Select Status
                                </option>

                                <option value="Active">
                                    Active
                                </option>

                                <option value="Inactive">
                                    Inactive
                                </option>

                            </select>

                        </div>


                        <div class="col-12 mb-3">

                            <label class="form-label">
                                About
                            </label>
                            <input type="text"
                                   name="AboutEmployee"
                                   class="form-control"
                                   required />

                        </div>

                    </div>


                    <button type="submit"
                            class="btn btn-primary">

                        Add Employee

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


