@{
}

@model List<Designation>

<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

@{
    ViewData["Title"] = "Designations";
}

<div class="row">
    <div class="col">
        <h2>Designation List</h2>

        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="/">Home</a>
            </li>

            <li class="breadcrumb-item">
                <a href="/Employee/Index">Employee</a>
            </li>

            <li class="breadcrumb-item active">
                Designation
            </li>
        </ol>
    </div>

    <div class="col-auto">
        <button type="button"class="btn" style="background-color:#f5820d;color:#fff;" data-bs-toggle="modal" data-bs-target="#addDepartmentModal">
            + Add Designation
        </button>
    </div>
</div>

<br />
<br />



<div class="modal fade" id="addDesignationModal" tabindex="-1" aria-labelledby="addDesignationModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="addDesignationModalLabel">
                    Add New Designation
                </h1>

                <button type="button"class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                </button>
            </div>

            <div class="modal-body">
                <form method="post"asp-controller="Employee"asp-action="AddDesignation">                   
 <label>Designation Name</label>
                   <input type="text" name="Name" class="form-control" required />
                    <br />
                    <br />
<label>Department</label>
                    <select name="DepartmentId" class="form-control" required>
                        <option value="">Select Department</option>
                        @foreach (var dept in ViewBag.Departments)
                        {
                            <option value="@dept.DepartmentId">@dept.Name</option>
                        }
                    </select>
                    <br />
                    <br />
<label>Status</label>
                    <select name="Status" class="form-control" required>
                    <option value=""> Select Status</option>
                        <option value="Active"> Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>
                    <br />
                    <br />

                    <input type="submit" value="Add Designation" class="btn" style="background-color:#f5820d;color:#fff;" />
                </form>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"> Close
                </button>
            </div>
        </div>
    </div>
</div>


<div class="card">
    <div class="card-header">
        <h5>Department List</h5>
    </div>
    <div class="card-body">
        <table id="designationsTable" class="table table-bordered"><thead>
<tr>
<th>Id</th>
<th>Name</th>
<th>No. Of Emp</th>
<th>Status</th>
<th>Created By</th>
<th>Modified By</th>
<th>Action</th>
</tr>
</thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>

                        <td>
                            @item.DesignationId
                        </td>

                        <td>
                            @item.Name
                        </td>
<td>@item.NoOfEmployee</td>

                        <td>

                            @if (item.status == "Active")
                            {
                                <span class="badge bg-success">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Inactive
                                </span>
                            }

                        </td>

                        <td>
                            @item.CreatedBy
                        </td>

                        <td>
                            @item.ModifiedBy
                        </td>

                        <td>
                            <button data-bs-toggle="modal"
                                    data-bs-target="#editDesignationModal"
                                    onclick="editDesignation(
                                '@item.DesignationId',
                                '@item.Name',
                                '@item.status'
                                )">
                                <i class="bi bi-pencil-square"></i>
                            </button>

                            @* Delete Button *@

                            <a asp-controller="Employee"
                               asp-action="DeleteDesignation"
                               asp-route-id="@item.DesignationId"
                               onclick="return confirm('Are you sure you want to delete this designation?');">

                                <i class="bi bi-trash"></i>

                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>
@* Edit Modal *@
<div class="modal fade" id="editDesignationModal" tabindex="-1" aria-labelledby="editDesignationModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="editDesignationModalLabel">Edit Designation</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form method="post" asp-controller="Employee" asp-action="EditDesignation">

                    <input type="text" name="DesignationId" id="editDesignationId" hidden="hidden" />

                    <br />

                    <label>Designation Name</label>
                    <input type="text" name="Name" id="editDesignationName" class="form-control" required />

                    <br />
<label>Department</label>
<select name="DepartmentId" id="editDepartmentId" class="form-control" required>
                        <option value="">Select Department</option>
                        @foreach (var dept in ViewBag.Departments)
                        {
                            <option value="@dept.DepartmentId">@dept.Name</option>
                        }   
                    <label>Status</label>
                    <select name="Status" id="editStatus" class="form-control" required>
                        <option value="">Select Status</option>
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>

                    <br />
                    <br />

                    <input type="submit" value="Update D" class="btn" style="background-color:#f5820d;color:#fff;" />

                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>




@section Scripts
{
    <script>

        function editDesignation(id, Name, status,modifiedBy) {

            document.getElementById("editDesignationId").value = id;

            document.getElementById("editDesignationName").value = Name;

            document.getElementById("editStatus").value = status;

        }


        $(document).ready(function () {

            $('#designationsTable').DataTable();

        });

    </script>
}