@{
}
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" />

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
@{

    ViewData["Title"] = "Roles";
}
<div class="d-flex justify-content-between align-items-center mb-2">
    <div>
        <h3 class="mb-0">Roles</h3>

        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/Employee/Index">Employee</a></li>
                <li class="breadcrumb-item active">Role</li>
            </ol>
        </nav>
    </div>

<div>
        <button type="button" class="btn btn-outline-secondary">
            <i class="bi bi-file-earmark-arrow-down"></i> Export
        </button>
        <button type="button" class="btn" style="background-color:#f5820d;color:#fff;"
                data-bs-toggle="modal" data-bs-target="#addRoleModal">
            + Add Role
        </button>
</div>
</div>
    <div class="card">

    <div class ="card-body">
            <h5 class="card-title mb-3">Role List</h5>
        <table id="rolesTable" class="table table-bordered table-hover align-middle w-100">
            

<thead>
<tr>
                <th>Id</th>
                <th>Role Name</th>
                <th>Status</th>
                <th>CreatedAt</th>
                <th>Created By</th>
                <th>Action</th>
</tr>
</thead>
                <tbody id="mydata"></tbody>
</table>
</div>
    </div>

<div class="modal fade" id="addRoleModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Add Role</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="addRoleForm">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Role Name</label>
                        <input type="text" name="RoleName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Status</label>
                        <select name="Status" class="form-select" required>
                            <option value="" disabled selected hidden>Select</option>
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn" style="background-color:#f5820d;color:#fff;">Add Role</button>
                </div>
            </form>
        </div>
    </div>
</div>


<script>
    $(document).ready(function () {
        loadRoles();

        $('#addRoleForm').on('submit', function (e) {
            e.preventDefault(); // stops the page from reloading

            $.post('/Employee/AddRole', $(this).serialize(), function (response) {
                if (response.success) {
                    $('#addRoleModal').modal('hide');
                    $('#addRoleForm')[0].reset();
                    loadRoles();
                } else {
                    alert(response.message);
                }
            });
        });
    });

    function loadRoles() {
        $.get('/Employee/GetAllRoles', function (roles) {
            $('#mydata').empty();

            for (var i = 0; i < roles.length; i++) {
                var r = roles[i];

                var row = '<tr>' +
                    '<td>' + r.roleId + '</td>' +
                    '<td>' + r.roleName + '</td>' +
                    '<td>' + r.status + '</td>' +
                    '<td>' + r.createdAt + '</td>' +
                    '<td>' + r.createdBy + '</td>' +
                    '<td></td>' +
                    '</tr>';

                $('#mydata').append(row);
            }
        });
    }
</script>