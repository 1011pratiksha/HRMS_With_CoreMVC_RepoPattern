@{
}

@model List<Department>

<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

@{
    ViewData["Title"] = "Departments";
}

<div class="row">
    <div class="col">
        <h2>Department List</h2>

        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="/">Home</a>
            </li>

            <li class="breadcrumb-item">
                <a href="/Employee/Index">Employee</a>
            </li>

            <li class="breadcrumb-item active">
                Department
            </li>
        </ol>
    </div>

    <div class="col-auto">
        <button type="button"class="btn" style="background-color:#f5820d;color:#fff;" data-bs-toggle="modal" data-bs-target="#addDepartmentModal">
            + Add Department
        </button>
    </div>
</div>

<br />
<br />



<div class="modal fade" id="addDepartmentModal" tabindex="-1" aria-labelledby="addDepartmentModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="addDepartmentModalLabel">
                    Add New Department
                </h1>

                <button type="button"class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                </button>
            </div>

            <div class="modal-body">
                <form method="post"asp-controller="Employee"asp-action="AddDepartment">                    <label>Department Name</label>
                   <input type="text" name="Name" class="form-control" required />
                    <br />
                    <br />
                    <label>Status</label>
                    <select name="Status" class="form-control" required>
                    <option value=""> Select Status</option>
                        <option value="Active"> Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>
                    <br />
                    <br />

                    <input type="submit" value="Add Department" class="btn" style="background-color:#f5820d;color:#fff;" />
                </form>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"> Close
                </button>
            </div>
        </div>
    </div>
</div>


<div class="card">
    <div class="card-header">
        <h5>Department List</h5>
    </div>
    <div class="card-body">
        <table id="departmentsTable" class="table table-bordered"><thead>
<tr>
<th>Id</th>
<th>Name</th>
<th>No. Of Emp</th>
<th>Status</th>
<th>Created By</th>
<th>Modified By</th>
<th>Action</th>
</tr>
</thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>

                        <td>
                            @item.DepartmentId
                        </td>

                        <td>
                            @item.Name
                        </td>
<td>@item.NoOfEmployee</td>

                        <td>

                            @if (item.Status == "Active")
                            {
                                <span class="badge bg-success">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Inactive
                                </span>
                            }

                        </td>

                        <td>
                            @item.CreatedBy
                        </td>

                        <td>
                            @item.ModifiedBy
                        </td>

                        <td>
                            <button data-bs-toggle="modal"
                                    data-bs-target="#editDepartmentModal"
                                    onclick="editDepartment(
                                '@item.DepartmentId',
                                '@item.Name',
                                '@item.Status'
                                )">
                                <i class="bi bi-pencil-square"></i>
                            </button>

                            @* Delete Button *@

                            <a asp-controller="Employee"
                               asp-action="DeleteDepartment"
                               asp-route-id="@item.DepartmentId"
                               onclick="return confirm('Are you sure you want to delete this department?');">

                                <i class="bi bi-trash"></i>

                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>
@* Edit Modal *@
<div class="modal fade" id="editDepartmentModal" tabindex="-1" aria-labelledby="editDepartmentModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="editDepartmentModalLabel">Edit Department</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form method="post" asp-controller="Employee" asp-action="EditDepartment">

                    <input type="text" name="DepartmentId" id="editDepartmentId" hidden="hidden" />

                    <br />

                    <label>Department Name</label>
                    <input type="text" name="Name" id="editDepartmentName" class="form-control" required />

                    <br />

                    <label>Status</label>
                    <select name="Status" id="editStatus" class="form-control" required>
                        <option value="">Select Status</option>
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>

                    <br />
                    <br />

                    <input type="submit" value="Update Department" class="btn" style="background-color:#f5820d;color:#fff;" />

                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>




@section Scripts
{
    <script>

        function editDepartment(id, Name, status,modifiedBy) {

            document.getElementById("editDepartmentId").value = id;

            document.getElementById("editDepartmentName").value = Name;

            document.getElementById("editStatus").value = status;

        }


        $(document).ready(function () {

            $('#departmentsTable').DataTable();

        });

    </script>
}