@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@model List<HRMS_With_CoreMVC_RepoPattern.Models.Training>

@{
    ViewData["Title"] = "Training";
}

<div class="d-md-flex d-block align-items-center justify-content-between page-breadcrumb mb-3">
    <div class="my-auto mb-2">
        <h2 class="mb-1">Training</h2>
        <nav>
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="#"><i class="ti ti-smart-home"></i></a></li>
                <li class="breadcrumb-item">Performance</li>
                <li class="breadcrumb-item active" aria-current="page">Training List</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex my-xl-auto right-content align-items-center flex-wrap">
        <div class="mb-2">
            <a href="#" class="btn btn-warning d-flex align-items-center" data-bs-toggle="modal" data-bs-target="#addModal">
                <i class="ti ti-circle-plus me-2"></i>Add Training
            </a>
        </div>
    </div>
</div>

@if (TempData["Message"] != null)
{
    <script>
        window.onload = function () {
            alert("@TempData["Message"]");
        };
    </script>
}

<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">
                <h5 class="d-flex align-items-center">Training List</h5>
                <div class="d-flex align-items-center flex-wrap row-gap-3">
                    <div class="me-2">
                        <select class="form-select">
                            <option>Sort By: Ascending</option>
                            <option>Sort By: Descending</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="custom-datatable-filter table-responsive">
                    <table id="trainingTable" class="table datatable">
                        <thead class="thead-light">
                            <tr>
                                <th>TrainingId</th>
                                <th>Trainer Name</th>
                                <th>Training Type</th>
                                <th>User (Employee)</th>
                                <th>Training Cost</th>
                                <th>Description</th>
                                <th>Status</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th class="no-sort">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.TrainingId</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            @if (!string.IsNullOrEmpty(item.Trainer.ProfilePicture))
                                            {
                                                <img src="@item.Trainer.ProfilePicture" class="rounded-circle me-2" width="30" height="30" />
                                            }
                                            @item.Trainer.FirstName @item.Trainer.LastName
                                        </div>
                                    </td>
                                    <td>@item.TrainingType.TrainingTypeName</td>
                                    <td>@item.User.FirstName @item.User.LastName</td>
                                    <td>@item.TrainingCost</td>
                                    <td>@item.Description</td>
                                    <td>
                                        @if (item.Status == "Active")
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Inactive</span>
                                        }
                                    </td>
                                    <td>@item.StartDate.ToString("yyyy-MM-dd")</td>
                                    <td>@item.EndDate.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        <div class="action-icon d-inline-flex">
                                            <a href="javascript:void(0);" class="me-2"
                                               data-bs-toggle="modal"
                                               data-bs-target="#editModal"
                                               onclick="loadEditModal(@item.TrainingId, @item.TrainerId, @item.TrainingTypeId, @item.UserId, @item.TrainingCost, '@item.Description', '@item.Status', '@item.StartDate.ToString("yyyy-MM-dd")', '@item.EndDate.ToString("yyyy-MM-dd")')"
                                               title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form asp-action="Delete" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this training?');">
                                                <input type="hidden" name="id" value="@item.TrainingId" />
                                                <button type="submit" class="btn btn-link p-0 border-0" title="Delete"><i class="bi bi-trash"></i></button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Modal -->
<div class="modal fade" id="addModal">
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Add Training List</h4>
                <button type="button" class="btn-close custom-btn-close" data-bs-dismiss="modal" aria-label="Close"><i class="ti ti-x"></i></button>
            </div>
            <form asp-action="Add" method="post">
                <div class="modal-body pb-0">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label class="form-label">Trainer</label>
                                <select name="TrainerId" class="form-select" required>
                                    <option value="">Select Trainer</option>
                                    @foreach (var tr in ViewBag.Trainer as List<HRMS_With_CoreMVC_RepoPattern.Models.Trainer>)
                                    {
                                        <option value="@tr.TrainerId">@tr.FirstName @tr.LastName</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label class="form-label">Training Type</label>
                                <select name="TrainingTypeId" class="form-select" required>
                                    <option value="">Select Training Type</option>
                                    @foreach (var tt in ViewBag.TrainingType as List<HRMS_With_CoreMVC_RepoPattern.Models.TrainingType>)
                                    {
                                        <option value="@tt.TrainingTypeId">@tt.TrainingTypeName</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label class="form-label">Employee</label>
                                <select name="UserId" class="form-select" required>
                                    <option value="">Select Employee</option>
                                    @foreach (var u in ViewBag.User as List<HRMS_With_CoreMVC_RepoPattern.Models.User>)
                                    {
                                        <option value="@u.UserId">@u.FirstName @u.LastName</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label class="form-label">Training Cost</label>
                                <input type="number" step="0.01" name="TrainingCost" class="form-control" required />
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label class="form-label">Description</label>
                                <textarea name="Description" class="form-control" required></textarea>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label class="form-label">Status</label>
                                <select name="Status" class="form-select" required>
                                    <option value="">Select</option>
                                    <option value="Active">Active</option>
                                    <option value="Inactive">Inactive</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Start Date</label>
                                <input type="date" name="StartDate" class="form-control" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">End Date</label>
                                <input type="date" name="EndDate" class="form-control" required />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-white border me-2" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">Submit</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal">
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Edit Training</h4>
                <button type="button" class="btn-close custom-btn-close" data-bs-dismiss="modal" aria-label="Close"><i class="ti ti-x"></i></button>
            </div>
            <form asp-action="Edit" method="post">
                <div class="modal-body pb-0">
                    <input type="hidden" name="TrainingId" id="editTrainingId" />
                    <div class="row">
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label class="form-label">Trainer</label>
                                <select name="TrainerId" id="editTrainerId" class="form-select" required>
                                    <option value="">Select Trainer</option>
                                    @foreach (var tr in ViewBag.Trainer as List<HRMS_With_CoreMVC_RepoPattern.Models.Trainer>)
                                    {
                                        <option value="@tr.TrainerId">@tr.FirstName @tr.LastName</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label class="form-label">Training Type</label>
                                <select name="TrainingTypeId" id="editTrainingTypeId" class="form-select" required>
                                    <option value="">Select Training Type</option>
                                    @foreach (var tt in ViewBag.TrainingType as List<HRMS_With_CoreMVC_RepoPattern.Models.TrainingType>)
                                    {
                                        <option value="@tt.TrainingTypeId">@tt.TrainingTypeName</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label class="form-label">Employee</label>
                                <select name="UserId" id="editUserId" class="form-select" required>
                                    <option value="">Select Employee</option>
                                    @foreach (var u in ViewBag.User as List<HRMS_With_CoreMVC_RepoPattern.Models.User>)
                                    {
                                        <option value="@u.UserId">@u.FirstName @u.LastName</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label class="form-label">Training Cost</label>
                                <input type="number" step="0.01" name="TrainingCost" id="editTrainingCost" class="form-control" required />
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label class="form-label">Description</label>
                                <textarea name="Description" id="editDescription" class="form-control" required></textarea>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label class="form-label">Status</label>
                                <select name="Status" id="editStatus" class="form-select" required>
                                    <option value="Active">Active</option>
                                    <option value="Inactive">Inactive</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Start Date</label>
                                <input type="date" name="StartDate" id="editStartDate" class="form-control" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">End Date</label>
                                <input type="date" name="EndDate" id="editEndDate" class="form-control" required />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-white border me-2" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            if ($.fn.DataTable.isDataTable('#trainingTable')) {
                $('#trainingTable').DataTable().destroy();
            }
            $('#trainingTable').DataTable({
                "info": false, "searching": true, "ordering": true, "order": [],
                "paging": true, "pageLength": 10, "lengthChange": false
            });
        });

        function loadEditModal(id, trainerId, trainingTypeId, userId, cost, description, status, startDate, endDate) {
            $('#editTrainingId').val(id);
            $('#editTrainerId').val(trainerId);
            $('#editTrainingTypeId').val(trainingTypeId);
            $('#editUserId').val(userId);
            $('#editTrainingCost').val(cost);
            $('#editDescription').val(description);
            $('#editStatus').val(status);
            $('#editStartDate').val(startDate);
            $('#editEndDate').val(endDate);
        }
    </script>
}