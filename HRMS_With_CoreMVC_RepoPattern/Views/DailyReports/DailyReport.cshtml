@model IEnumerable<HRMS_With_CoreMVC_RepoPattern.Models.DailyReport>

@{
    ViewData["Title"] = "Daily Report";

    int totalPresent = ViewBag.TotalPresent ?? 0;
    int totalAbsent = ViewBag.TotalAbsent ?? 0;
    int completedTasks = ViewBag.CompletedTasks ?? 0;
    int pendingTasks = ViewBag.PendingTasks ?? 0;
    int presentCount = ViewBag.PresentCount ?? 0;
    int absentCount = ViewBag.AbsentCount ?? 0;
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">Daily Report</h2>

            <nav>
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item">
                        <a asp-controller="Home" asp-action="Index" class="text-decoration-none">Home</a>
                    </li>
                    <li class="breadcrumb-item active">Daily Report</li>
                </ol>
            </nav>
        </div>

        <div class="position-relative">

            <button type="button" id="exportButton" class="btn btn-primary">
                <i class="bi bi-download"></i> Export <span class="ms-1">▼</span>
            </button>

            <div id="exportMenu"
                 class="position-absolute bg-white border rounded shadow"
                 style="display:none;right:0;top:100%;margin-top:5px;min-width:190px;z-index:9999;">

                <a href="#" id="exportPdf" class="dropdown-item py-3 px-3">
                    <i class="bi bi-file-earmark-pdf text-danger me-2"></i> Export as PDF
                </a>

                <a href="#" id="exportExcel" class="dropdown-item py-3 px-3">
                    <i class="bi bi-file-earmark-excel text-success me-2"></i> Export as Excel
                </a>

            </div>

        </div>

    </div>

    <div class="row g-4 mb-4 align-items-stretch">

        <div class="col-lg-6 d-flex">

            <div class="row g-4 w-100 h-100">

                <div class="col-md-6 d-flex">
                    <div class="card shadow-sm border-0 h-100 w-100">

                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-center">

                                <div>
                                    <h6 class="text-muted mb-2">Total Present</h6>
                                    <h2 class="fw-bold mb-0">@totalPresent</h2>
                                </div>

                                <div class="bg-success bg-opacity-10 rounded-circle p-3">
                                    <i class="bi bi-person-check text-success fs-4"></i>
                                </div>

                            </div>

                        </div>

                    </div>
                </div>

                <div class="col-md-6 d-flex">
                    <div class="card shadow-sm border-0 h-100 w-100">

                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-center">

                                <div>
                                    <h6 class="text-muted mb-2">Completed Tasks</h6>
                                    <h2 class="fw-bold mb-0">@completedTasks</h2>
                                </div>

                                <div class="bg-success bg-opacity-10 rounded-circle p-3">
                                    <i class="bi bi-check2-square text-success fs-4"></i>
                                </div>

                            </div>

                        </div>

                    </div>
                </div>

                <div class="col-md-6 d-flex">
                    <div class="card shadow-sm border-0 h-100 w-100">

                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-center">

                                <div>
                                    <h6 class="text-muted mb-2">Total Absent</h6>
                                    <h2 class="fw-bold mb-0">@totalAbsent</h2>
                                </div>

                                <div class="bg-danger bg-opacity-10 rounded-circle p-3">
                                    <i class="bi bi-person-x text-danger fs-4"></i>
                                </div>

                            </div>

                        </div>

                    </div>
                </div>

                <div class="col-md-6 d-flex">
                    <div class="card shadow-sm border-0 h-100 w-100">

                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-center">

                                <div>
                                    <h6 class="text-muted mb-2">Pending Tasks</h6>
                                    <h2 class="fw-bold mb-0">@pendingTasks</h2>
                                </div>

                                <div class="bg-info bg-opacity-10 rounded-circle p-3">
                                    <i class="bi bi-clock text-info fs-4"></i>
                                </div>

                            </div>

                        </div>

                    </div>
                </div>

            </div>

        </div>

        <div class="col-lg-6 d-flex">

            <div class="card shadow-sm border-0 h-100 w-100">

                <div class="card-header bg-white">

                    <div class="d-flex justify-content-between align-items-center">

                        <h5 class="mb-0 fw-bold">
                            <i class="bi bi-bar-chart text-danger me-2"></i>
                            Daily Attendance
                        </h5>

                        <div class="d-flex gap-3">

                            <span>
                                <span class="badge" style="background:#20c997;">&nbsp;</span>
                                Present
                            </span>

                            <span>
                                <span class="badge" style="background:#dc3545;">&nbsp;</span>
                                Absent
                            </span>

                        </div>

                    </div>

                </div>

                <div class="card-body">

                    <div style="height:260px;">
                        <canvas id="attendanceChart"></canvas>
                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="card shadow-sm border-0">

        <div class="card-header bg-white">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="mb-0 fw-bold">Daily Attendance List</h5>

                <div class="d-flex gap-3">

                    <select id="statusFilter" class="form-select" style="width:150px;">
                        <option value="">Select Status</option>
                        <option value="Present">Present</option>
                        <option value="Absent">Absent</option>
                        <option value="Completed">Completed</option>
                        <option value="Pending">Pending</option>
                    </select>

                    <select id="sortFilter" class="form-select" style="width:180px;">
                        <option value="">Sort By</option>
                        <option value="ascending">Ascending</option>
                        <option value="descending">Descending</option>
                        <option value="last7">Last 7 Days</option>
                    </select>

                </div>

            </div>

        </div>

        <div class="card-body">

            <div class="row mb-3 align-items-center">

                <div class="col-md-6">

                    <div class="d-flex align-items-center gap-2">

                        <span>Row Per Page</span>

                        <select id="pageSize" class="form-select" style="width:70px;">
                            <option value="10">10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>

                        <span>Entries</span>

                    </div>

                </div>

                <div class="col-md-6 text-md-end">

                    <div class="d-inline-flex align-items-center gap-2">

                        <span>Search</span>

                        <input type="text"
                               id="searchBox"
                               class="form-control"
                               style="width:190px;"
                               placeholder="Search" />

                    </div>

                </div>

            </div>

            <div class="table-responsive">

                <table id="dailyReportTable"
                       class="table table-bordered table-hover align-middle">

                    <thead class="table-light">

                        <tr>
                            <th>Name</th>
                            <th>Date</th>
                            <th>Department</th>
                            <th>Status</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>@item.UserName</td>

                                <td>@item.Date.ToString("yyyy-MM-dd")</td>

                                <td>@item.Department</td>

                                <td>

                                    @if (item.Status == "Present")
                                    {
                                        <span class="badge bg-success">Present</span>
                                    }
                                    else if (item.Status == "Absent")
                                    {
                                        <span class="badge bg-danger">Absent</span>
                                    }
                                    else if (item.Status == "Completed")
                                    {
                                        <span class="badge bg-primary">Completed</span>
                                    }
                                    else if (item.Status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@item.Status</span>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <div class="d-flex justify-content-between align-items-center mt-3">

                <div id="showingText" class="text-muted"></div>

                <div class="d-flex gap-2">

                    <button type="button"
                            id="previousButton"
                            class="btn btn-outline-secondary btn-sm">
                        Previous
                    </button>

                    <button type="button"
                            id="nextButton"
                            class="btn btn-outline-primary btn-sm">
                        Next
                    </button>

                </div>

            </div>

        </div>

    </div>

</div>

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<script src="https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>

<script>

    const presentCount = @presentCount;
    const absentCount = @absentCount;

    const ctx = document.getElementById("attendanceChart");

    new Chart(ctx, {
        type: "bar",
        data: {
            labels: ["Present", "Absent"],
            datasets: [{
                label: "Employees",
                data: [presentCount, absentCount],
                backgroundColor: ["#20c997", "#dc3545"],
                borderRadius: 5,
                barThickness: 45
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: false
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        stepSize: 1
                    }
                }
            }
        }
    });

</script>

<script>

    let currentPage = 1;

    function getAllRows() {
        return Array.from(
            document.querySelectorAll("#dailyReportTable tbody tr")
        );
    }

    function updateTable() {

        const searchText =
            document.getElementById("searchBox").value.toLowerCase();

        const status =
            document.getElementById("statusFilter").value;

        const sortType =
            document.getElementById("sortFilter").value;

        const pageSize =
            parseInt(document.getElementById("pageSize").value);

        let rows = getAllRows();

        rows = rows.filter(function (row) {
            return row.innerText.toLowerCase().includes(searchText);
        });

        if (status !== "") {

            rows = rows.filter(function (row) {

                const rowStatus =
                    row.cells[3].innerText.trim();

                return rowStatus === status;

            });

        }

        if (sortType === "ascending") {

            rows.sort(function (a, b) {

                const dateA =
                    new Date(a.cells[1].innerText.trim());

                const dateB =
                    new Date(b.cells[1].innerText.trim());

                return dateA - dateB;

            });

        }

        if (sortType === "descending") {

            rows.sort(function (a, b) {

                const dateA =
                    new Date(a.cells[1].innerText.trim());

                const dateB =
                    new Date(b.cells[1].innerText.trim());

                return dateB - dateA;

            });

        }

        if (sortType === "last7") {

            const today = new Date();

            today.setHours(23, 59, 59, 999);

            const sevenDaysAgo = new Date();

            sevenDaysAgo.setDate(
                today.getDate() - 7
            );

            sevenDaysAgo.setHours(0, 0, 0, 0);

            rows = rows.filter(function (row) {

                const date =
                    new Date(row.cells[1].innerText.trim());

                return date >= sevenDaysAgo &&
                       date <= today;

            });

            rows.sort(function (a, b) {

                const dateA =
                    new Date(a.cells[1].innerText.trim());

                const dateB =
                    new Date(b.cells[1].innerText.trim());

                return dateB - dateA;

            });

        }

        const totalRows = rows.length;
        const totalPages = Math.ceil(totalRows / pageSize);

        if (currentPage > totalPages) {
            currentPage = totalPages || 1;
        }

        getAllRows().forEach(function (row) {
            row.style.display = "none";
        });

        const start =
            (currentPage - 1) * pageSize;

        const end =
            start + pageSize;

        rows.slice(start, end).forEach(function (row) {
            row.style.display = "";
        });

        const showingText =
            document.getElementById("showingText");

        if (totalRows === 0) {

            showingText.innerText =
                "Showing 0 entries";

        }
        else {

            showingText.innerText =
                "Showing " +
                (start + 1) +
                " to " +
                Math.min(end, totalRows) +
                " of " +
                totalRows +
                " entries";

        }

        document.getElementById("previousButton").disabled =
            currentPage <= 1;

        document.getElementById("nextButton").disabled =
            currentPage >= totalPages;

    }

    document.getElementById("searchBox").addEventListener("input", function () {

        currentPage = 1;
        updateTable();

    });

    document.getElementById("statusFilter").addEventListener("change", function () {

        currentPage = 1;
        updateTable();

    });

    document.getElementById("sortFilter").addEventListener("change", function () {

        currentPage = 1;
        updateTable();

    });

    document.getElementById("pageSize").addEventListener("change", function () {

        currentPage = 1;
        updateTable();

    });

    document.getElementById("previousButton").addEventListener("click", function () {

        if (currentPage > 1) {

            currentPage--;
            updateTable();

        }

    });

    document.getElementById("nextButton").addEventListener("click", function () {

        currentPage++;
        updateTable();

    });

    updateTable();

</script>

<script>

    const exportButton =
        document.getElementById("exportButton");

    const exportMenu =
        document.getElementById("exportMenu");

    exportButton.addEventListener("click", function (e) {

        e.preventDefault();
        e.stopPropagation();

        if (exportMenu.style.display === "block") {
            exportMenu.style.display = "none";
        }
        else {
            exportMenu.style.display = "block";
        }

    });

    document.addEventListener("click", function () {
        exportMenu.style.display = "none";
    });

</script>

<script>

    document.getElementById("exportExcel").addEventListener("click", function (e) {

        e.preventDefault();
        e.stopPropagation();

        exportMenu.style.display = "none";

        const rows = [];

        rows.push([
            "Employee Name",
            "Date",
            "Department",
            "Status"
        ]);

        const tableRows =
            document.querySelectorAll(
                "#dailyReportTable tbody tr"
            );

        tableRows.forEach(function (row) {

            const cells =
                row.querySelectorAll("td");

            if (cells.length >= 4) {

                rows.push([
                    cells[0].innerText.trim(),
                    cells[1].innerText.trim(),
                    cells[2].innerText.trim(),
                    cells[3].innerText.trim()
                ]);

            }

        });

        const worksheet =
            XLSX.utils.aoa_to_sheet(rows);

        const workbook =
            XLSX.utils.book_new();

        XLSX.utils.book_append_sheet(
            workbook,
            worksheet,
            "Daily Report"
        );

        XLSX.writeFile(
            workbook,
            "Daily_Report.xlsx"
        );

    });

</script>

<script>

    document.getElementById("exportPdf").addEventListener("click", function (e) {

        e.preventDefault();
        e.stopPropagation();

        exportMenu.style.display = "none";

        if (!window.jspdf) {

            alert("PDF library not loaded.");
            return;

        }

        const { jsPDF } = window.jspdf;

        const doc =
            new jsPDF("landscape");

        doc.setFontSize(18);
        doc.text("Daily Report", 14, 15);

        const pdfRows = [];

        const tableRows =
            document.querySelectorAll(
                "#dailyReportTable tbody tr"
            );

        tableRows.forEach(function (row) {

            const cells =
                row.querySelectorAll("td");

            if (cells.length >= 4) {

                pdfRows.push([
                    cells[0].innerText.trim(),
                    cells[1].innerText.trim(),
                    cells[2].innerText.trim(),
                    cells[3].innerText.trim()
                ]);

            }

        });

        if (typeof doc.autoTable !== "function") {

            alert("PDF table library not loaded.");
            return;

        }

        doc.autoTable({

            head: [[
                "Employee Name",
                "Date",
                "Department",
                "Status"
            ]],

            body: pdfRows,

            startY: 25,

            theme: "grid",

            styles: {
                fontSize: 9
            }

        });

        doc.save("Daily_Report.pdf");

    });

</script>