@{
}

@model List<HRMS_With_CoreMVC_RepoPattern.Models.Timesheet>
@{
    ViewData["Title"] = "My Timesheet";
}
<div class="container mt-4">
    <h1 class="mb-4">My Timesheet</h1>
    <div class="card mb-4">
        <div class="card-header">Add Timesheet</div>
        <div class="card-body">
            <form asp-controller="Timesheet" asp-action="AddTimesheet" method="post">
                <div class="row">
                    <div class="col-md-4">
                        <label class="form-label">Date</label>
                        <input type="date" name="Date" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Project</label>
                        <select name="ProjectId" class="form-select" required>
                            <option value="">Select Project</option>
                            @if (ViewBag.Projects != null)
                            {
                                foreach (var project in ViewBag.Projects)
                                {
                                    <option value="@project.ProjectId">@project.ProjectName</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Work Hours</label>
                        <input type="number" name="WorkHours" class="form-control" min="1" required />
                    </div>
                </div>
                <button type="submit" class="btn btn-primary mt-3">Submit Timesheet</button>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0">My Timesheet History</h5>
                <input type="text" id="searchProject" class="form-control" placeholder="Search by Project" style="width:250px;" />
            </div>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <span>Show</span>
                <select id="rowsPerPage" class="form-select d-inline-block ms-2" style="width:90px;">
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select>
                <span class="ms-2">entries</span>
            </div>

            <div class="table-responsive">
                <table class="table" id="employeeTimesheetTable">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Project</th>
                            <th>Work Hours</th>
                            <th>Status</th>
                            <th>Created At</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Date.ToString("dd-MM-yyyy")</td>
                                    <td class="project-name">@item.Projects?.ProjectName</td>
                                    <td>@item.WorkHours</td>
                                    <td class="status">
                                        @if (item.Status == "Approved")
                                        {
                                            <span class="badge bg-success">Approved</span>
                                        }
                                        else if (item.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger">Rejected</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Pending</span>
                                        }
                                    </td>
                                    <td>@item.CreatedAt.ToString("dd-MM-yyyy")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center">No timesheets found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-3">
                <div id="pageInfo"></div>
                <nav>
                    <ul class="pagination mb-0" id="pagination"></ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<script>
    var currentPage = 1;
    var rowsPerPage = 5;

    function getRows() {
        return Array.from(document.querySelectorAll("#employeeTimesheetTable tbody tr"));
    }

    function filterRows() {
        var search = document.getElementById("searchProject").value.toLowerCase();
        var rows = getRows();

        rows.forEach(function(row) {
            var project = row.querySelector(".project-name");
            if (!project) return;
            var projectName = project.innerText.trim().toLowerCase();
            row.dataset.visible = projectName.includes(search) ? "true" : "false";
        });

        currentPage = 1;
        showPage();
    }

    function showPage() {
        var rows = getRows();
        var visibleRows = rows.filter(function(row) {
            return row.dataset.visible !== "false";
        });
        var totalPages = Math.ceil(visibleRows.length / rowsPerPage);

        rows.forEach(function(row) {
            row.style.display = "none";
        });

        var start = (currentPage - 1) * rowsPerPage;
        var end = start + rowsPerPage;

        visibleRows.slice(start, end).forEach(function(row) {
            row.style.display = "";
        });

        createPagination(totalPages);

        if (visibleRows.length === 0) {
            document.getElementById("pageInfo").innerText = "Showing 0 entries";
        }
        else {
            var first = start + 1;
            var last = Math.min(end, visibleRows.length);
            document.getElementById("pageInfo").innerText = "Showing " + first + " to " + last + " of " + visibleRows.length + " entries";
        }
    }

    function createPagination(totalPages) {
        var pagination = document.getElementById("pagination");
        pagination.innerHTML = "";

        if (totalPages <= 1) return;

        var previous = document.createElement("li");
        previous.className = "page-item";
        if (currentPage === 1) previous.classList.add("disabled");
        previous.innerHTML = '<a class="page-link" href="#">«</a>';
        previous.onclick = function(event) {
            event.preventDefault();
            if (currentPage > 1) {
                currentPage--;
                showPage();
            }
        };
        pagination.appendChild(previous);

        for (var i = 1; i <= totalPages; i++) {
            var page = document.createElement("li");
            page.className = "page-item";
            if (i === currentPage) page.classList.add("active");
            page.innerHTML = '<a class="page-link" href="#">' + i + '</a>';
            page.onclick = function(pageNumber) {
                return function(event) {
                    event.preventDefault();
                    currentPage = pageNumber;
                    showPage();
                };
            }(i);
            pagination.appendChild(page);
        }

        var next = document.createElement("li");
        next.className = "page-item";
        if (currentPage === totalPages) next.classList.add("disabled");
        next.innerHTML = '<a class="page-link" href="#">»</a>';
        next.onclick = function(event) {
            event.preventDefault();
            if (currentPage < totalPages) {
                currentPage++;
                showPage();
            }
        };
        pagination.appendChild(next);
    }

    document.getElementById("rowsPerPage").addEventListener("change", function() {
        rowsPerPage = parseInt(this.value);
        currentPage = 1;
        showPage();
    });

    document.getElementById("searchProject").addEventListener("keyup", filterRows);

    getRows().forEach(function(row) {
        row.dataset.visible = "true";
    });

    showPage();
</script>